---
import BaseLayout from './BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import '../styles/pages.css';
import { SITE } from '../site';
import { type Post, getPosts, formatDate, readingMinutes, shareImageUrl, postUrl, coverUrl, coverAlt } from '../lib/posts';
import { blogPostingSchema, breadcrumbSchema, faqSchema } from '../lib/schema';
import { competitorsIn, toolsIn, listNames } from '../data/competitors';
import ExploreLinks from '../components/ExploreLinks.astro';
import { POST_TRADES, POST_TOOLS } from '../data/links';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, seoTitle, description, author, category, pubDate, updatedDate, faq, draft, imageAlt } = post.data;
const schema = [
  blogPostingSchema(post),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog/' },
    { name: title, path: postUrl(post) },
  ]),
  ...(faq.length ? [faqSchema(faq)] : []),
];

// Two-tone headline like the rest of the site: anything after a colon goes orange.
const colon = title.indexOf(': ');
const titleLead = colon > 0 ? title.slice(0, colon + 1) : title;
const titleAccent = colon > 0 ? title.slice(colon + 2) : '';
const initials = author.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();

// Comparison posts get a disclaimer at the bottom, so it's always fair and clearly our own view.
const allText = `${title} ${description} ${post.body ?? ''} ${faq.map((f) => `${f.question} ${f.answer}`).join(' ')}`;
const rivals = competitorsIn(allText);
const tools = toolsIn(allText);

// Up to three more posts: same category first, then the newest.
const others = (await getPosts()).filter((p) => p.id !== post.id && !p.data.draft);
const related = [...others.filter((p) => p.data.category === category), ...others.filter((p) => p.data.category !== category)].slice(0, 3);
---
<BaseLayout
  title={seoTitle ?? (`${title} | ${SITE.name}`.length > 60 ? title : `${title} | ${SITE.name}`)}
  description={description}
  image={shareImageUrl(post)}
  imageAlt={imageAlt ?? title}
  type="article"
  noindex={draft}
  schema={schema}
  current="blog"
>
  <section class="page-head big-head post-head"><div class="wrap">
    <div class="crumbs"><a href="/blog/">Blog</a> <span>/</span> <span class="post-cat">{category}</span></div>
    {draft && <div class="draft-flag">Draft · not on the live site</div>}
    <h1>{titleLead}{titleAccent && <> <span>{titleAccent}</span></>}</h1>
    <div class="post-byline">
      <a class="post-avatar" href="/meet-the-team/" aria-hidden="true" tabindex="-1">{initials}</a>
      <div class="meta">
        <a class="post-author" href="/meet-the-team/" rel="author">{author}</a> · <time datetime={pubDate.toISOString().slice(0, 10)}>{formatDate(pubDate)}</time>{updatedDate && <> · Updated <time datetime={updatedDate.toISOString().slice(0, 10)}>{formatDate(updatedDate)}</time></>}{` · ${readingMinutes(post.body)} min read`}
      </div>
    </div>
  </div></section>
  <div class="wrap"><figure class="post-cover"><img src={coverUrl(post)} alt={coverAlt(post)} width="1200" height="675" fetchpriority="high" /></figure></div>
  <div class="wrap"><article class="prose post-body">
    <slot />
    {faq.length > 0 && (
      <section class="post-faq faq-list" aria-labelledby="faq">
        <div class="eyebrow">Questions</div>
        <h2 id="faq">FAQ</h2>
        {faq.map(({ question, answer }, i) => (
          <details open={i === 0}>
            <summary><h3>{question}</h3></summary>
            <p>{answer}</p>
          </details>
        ))}
      </section>
    )}
    {(rivals.length > 0 || tools.length > 0) && (
      <aside class="post-disclaimer" aria-label="Disclaimer">
        {rivals.length > 0 && (
          <p><strong>About this comparison:</strong> {listNames(rivals)} {rivals.length > 1 ? 'are trademarks of their respective owners' : 'is a trademark of its owner'}. Banksman is not affiliated with, endorsed by or sponsored by {rivals.length > 1 ? 'them' : 'it'}. This article is our own opinion of which tools suit smaller UK building firms, based on publicly available information at the time of writing. Products and features change, so check each provider's website for their latest details. If you spot anything out of date or inaccurate, email <a href="mailto:matt@dm4u.ai">matt@dm4u.ai</a> and we'll correct it.</p>
        )}
        {tools.length > 0 && (
          <p>{listNames(tools)} {tools.length > 1 ? 'are trademarks of their respective owners' : 'is a trademark of its owner'}. Banksman is not affiliated with or endorsed by {tools.length > 1 ? 'them' : 'it'}. Any comments are about how these tools are commonly used on building sites, not about the products themselves.</p>
        )}
      </aside>
    )}
  </article></div>

  <ExploreLinks
    eyebrow="Put it into practice"
    title="Banksman for your trade."
    postCount={0}
    trades={POST_TRADES[post.id] ?? ['builders', 'subcontractors', 'bricklayers', 'groundworkers']}
    tools={POST_TOOLS[post.id] ?? ['/tools/day-rate-calculator/', '/tools/cis-calculator/']}
    extra={[{ href: '/compare/', text: 'Banksman vs spreadsheets & WhatsApp' }]}
  />

  {related.length > 0 && (
    <section class="related">
      <div class="wrap">
        <div class="eyebrow">Keep reading</div>
        <h2 class="big">More from the blog.</h2>
        <div class="related-grid">
          {related.map((p) => (
            <a class="related-card" href={postUrl(p)}>
              <div class="rc-img"><img src={coverUrl(p)} alt={coverAlt(p)} width="1200" height="675" loading="lazy" /></div>
              <div class="rc-body">
                <span class="tag">{p.data.category}</span>
                <h3>{p.data.title}</h3>
                <span class="meta">{formatDate(p.data.pubDate)} · {readingMinutes(p.body)} min read</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand heading="See how it works on site." />
</BaseLayout>
