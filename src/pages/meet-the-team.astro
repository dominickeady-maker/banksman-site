---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../site';
import '../styles/pages.css';

// Layout "Spotlight": one large alternating row per person.

// Team members. To add a real photo, put it in public/assets/team/ and set `photo` to its path,
// e.g. photo: '/assets/team/dom.webp'. Until then the card shows the person's initials.
const TEAM = [
  {
    name: 'Dom Keady',
    initials: 'DK',
    role: 'CEO & founder',
    photo: '',
    phone: '07508 300353',
    phoneIntl: '+447508300353',
    email: 'dom@dm4u.ai',
    bio: [
      'Dom is a bricklayer by trade and runs his own building firm in Huddersfield, taking on new builds, extensions, renovations, retaining walls and hard landscaping.',
      'Banksman was his idea. He got sick of running his own sites on WhatsApp groups and a biro, and couldn’t find software that suited a firm his size without the enterprise price tag. So he built the app he wanted: one place for tasks, drawings, timesheets, materials and site photos that the whole team would actually use.',
      'He still runs his own jobs, so Banksman is shaped by what happens on a real site, not in a boardroom.',
    ],
  },
  {
    name: 'Matt Guille',
    initials: 'MG',
    role: 'CMO',
    photo: '/assets/team/matt.webp',
    phone: '07964 660071',
    phoneIntl: '+447964660071',
    email: 'matt@dm4u.ai',
    bio: [
      'Matt has more than ten years in marketing behind him, most of it helping a software start-up grow, with time in travel and e-commerce along the way.',
      'He’s a true all-rounder. Matt is as comfortable writing code or designing graphics as he is planning a campaign, which means ideas go from a sketch to something live without getting lost between departments.',
      'At Banksman he looks after how the app reaches the builders who need it, from the website and content to getting the word out.',
    ],
  },
];

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Meet the team behind Banksman',
  url: `${SITE.url}/meet-the-team/`,
  mainEntity: {
    '@type': 'Organization',
    name: 'Banksman',
    parentOrganization: { '@type': 'Organization', name: SITE.company },
    '@id': `${SITE.url}/#organization`,
    url: `${SITE.url}/`,
    employee: TEAM.map((p) => ({
      '@type': 'Person', name: p.name, jobTitle: p.role, telephone: p.phoneIntl, email: p.email,
      description: p.bio[0],
      worksFor: { '@id': `${SITE.url}/#organization` },
      ...(p.photo ? { image: `${SITE.url}${p.photo}` } : {}),
    })),
  },
}];
---
<BaseLayout
  title="Meet the team behind Banksman, built by a builder"
  description="The people behind Banksman: a working builder who got fed up of running sites on WhatsApp, and a marketer who's spent a decade growing software start-ups."
  schema={schema}
  current="team"
  image="/og/meet-the-team.png"
  imageAlt="Meet the team behind Banksman"
>
  <section class="tm-head page-head"><div class="wrap">
    <div class="eyebrow">Meet the team</div>
    <h1>Small team, <span>Real experience.</span></h1>
    <p>Banksman isn't made by a big software company. It's made by a builder who needed it and a marketer who knows how to get it in front of the people it's for. When you ring Banksman, you get Dom or Matt: real people, no bots or call centres.</p>
  </div></section>

  {TEAM.map((person, i) => (
    <section class={`tm-row ${i % 2 ? 'flip' : ''}`} style={`--c:${i % 2 ? 'var(--sky)' : 'var(--accent)'}`}>
      <div class="wrap tm-grid">
        <div class="tm-visual">
          <div class="tm-frame">
            {person.photo
              ? <img src={person.photo} alt={`${person.name}, ${person.role} at Banksman`} width="960" height="720" loading="lazy" />
              : <div class="tm-init" aria-hidden="true"><span>{person.initials}</span><img class="tm-art" src="/assets/illustrations/worker-phone.svg" alt="" width="400" height="400" loading="lazy"></div>}
          </div>
        </div>
        <div class="tm-text">
          <div class="eyebrow">{person.role}</div>
          <h2>{person.name}</h2>
          {person.bio.map((para) => <p>{para}</p>)}
          <div class="tm-contact">
            <a class="btn btn-primary" href={`tel:${person.phoneIntl}`}>Call {person.name.split(' ')[0]}: {person.phone}</a>
            <a class="btn btn-ghost" href={`mailto:${person.email}`}>{person.email}</a>
          </div>
        </div>
      </div>
    </section>
  ))}

  <CtaBand />
</BaseLayout>

<style>
  .tm-head{text-align:center;}
  .tm-head .eyebrow{justify-content:center;}
  .tm-head h1{margin-left:auto; margin-right:auto; max-width:16ch;}
  .tm-head h1 span{color:var(--accent);}
  .tm-head p{margin-left:auto; margin-right:auto; max-width:62ch;}
  .tm-row{padding:50px 0;}
  .tm-grid{display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center;}
  .tm-row.flip .tm-visual{order:2;}
  .tm-visual{padding:20px;}
  .tm-frame{border-radius:20px; overflow:hidden; border:1px solid var(--line-strong); box-shadow:0 30px 70px rgba(0,0,0,.5), 0 0 0 6px color-mix(in srgb, var(--c) 25%, transparent); rotate:-2deg; aspect-ratio:4/3; background:var(--surface-2); animation:tmFloat 8s ease-in-out infinite;}
  .tm-row.flip .tm-frame{rotate:2deg; animation-delay:-4s;}
  .tm-frame > img{width:100%; height:100%; object-fit:cover; display:block;}
  .tm-init{position:relative; width:100%; height:100%; display:grid; place-items:center; background:radial-gradient(circle at 30% 30%, rgba(255,122,46,.35), transparent 60%), linear-gradient(160deg, #1f2740, #12172a);}
  .tm-init span{font:800 120px/1 'Big Shoulders Display',sans-serif; color:var(--accent); opacity:.9;}
  .tm-art{position:absolute; right:18px; top:18px; width:150px; height:150px; filter:drop-shadow(0 16px 30px rgba(0,0,0,.45)); animation:sttBob 6s ease-in-out infinite;}
  .tm-text h2{font-size:clamp(40px,5vw,60px); line-height:1; margin:8px 0 16px;}
  .tm-text p{color:var(--ink-soft); font-size:16.5px;}
  .tm-contact{display:flex; flex-wrap:wrap; gap:12px; margin-top:22px;}
  @keyframes tmFloat{0%,100%{translate:0 0;} 50%{translate:0 -8px;}}
  @media (max-width:900px){ .tm-grid{grid-template-columns:1fr; gap:24px;} .tm-row.flip .tm-visual{order:0;} .tm-visual{padding:10px 6px;} .tm-init span{font-size:90px;} .tm-art{width:110px; height:110px;} }
  @media (prefers-reduced-motion: reduce){ .tm-frame, .tm-art{animation:none;} }
</style>
