---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpamGuard from '../components/SpamGuard.astro';
import HeroDevices from '../components/HeroDevices.astro';
import FaqPhones from '../components/FaqPhones.astro';
import { SITE } from '../site';
import { FEATURES, type FeatureId } from '../data/features';
import { FAQ } from '../data/faq';
import '../styles/pages.css';

// Features section: names and descriptions come from src/data/features.ts, so edit them there.
const ICONS: Record<string, string> = {
  dashboard: '<rect x="3" y="3" width="7" height="8" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="15" width="7" height="6" rx="1"/>',
  tasks: '<rect x="5" y="3" width="14" height="18" rx="1.5"/><path d="M9 3v2a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1V3"/><path d="M8 11h8M8 15h5"/>',
  timesheets: '<circle cx="12" cy="13" r="7.5"/><path d="M12 9v4l2.5 2M9 2h6"/>',
  materials: '<path d="M14 17H9.5M4.5 17H2.5V6h11.5v11"/><path d="M14 9h4l3.5 4v4h-1.5"/><circle cx="7" cy="17.5" r="2"/><circle cx="17.5" cy="17.5" r="2"/>',
  workerDashboard: '<rect x="6" y="2.5" width="12" height="19" rx="2"/><path d="M9 8l1.3 1.3L12.5 7M14 8h1.5M9 12.5l1.3 1.3 2.2-2.3M14 12.5h1.5M11 18.5h2"/>',
  accidents: '<path d="M12 3.5 21.5 20h-19L12 3.5Z"/><path d="M12 10v4.5M12 17.2h.01"/>',
  csv: '<path d="M6 3h9l4 4v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M15 3v4h4M12 10v7M9 14l3 3 3-3"/>',
  programme: '<path d="M3 5h18M3 19h18"/><rect x="4" y="8" width="7" height="3" rx="1"/><rect x="9" y="13" width="9" height="3" rx="1"/>',
  drawings: '<path d="M6 3h9l4 4v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M15 3v4h4M8 12h8M8 16h5"/>',
  photos: '<rect x="3" y="6" width="18" height="14" rx="2"/><circle cx="12" cy="13" r="3.5"/><path d="M8 6l1.5-2.5h5L16 6"/>',
  messages: '<path d="M4 5h16v11H8l-4 4V5Z"/><path d="M8 9h8M8 12.5h5"/>',
  hsDocs: '<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6l8-3Z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
  signIn: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM18 18h3v3M21 14v1"/>',
};
const headline: FeatureId[] = ['dashboard', 'workerDashboard', 'timesheets', 'materials', 'drawings', 'photos', 'messages', 'hsDocs', 'signIn', 'accidents', 'csv'];
// Live features left out of "The personal touch" list (covered above, or not worth a tile on the homepage).
const notInExtras: FeatureId[] = ['tasks', 'workers', 'pwa'];
const extras = (Object.keys(FEATURES) as FeatureId[]).filter((id) => FEATURES[id].status === 'live' && !headline.includes(id) && !notInExtras.includes(id));
// Homepage-only wording for site sign-in (the shared text in features.ts is used on the trade pages).
const homeText: Partial<Record<FeatureId, { name: string; summary: string }>> = {
  signIn: { name: 'Site sign-in with a location radius', summary: 'Scan the QR poster to sign in and out. Set a radius for each site and sign-ins from further away get flagged, so no latecomers pulling the wool over your eyes. Location is checked at sign-in only, never tracked.' },
};
const featText = (id: FeatureId) => homeText[id] ?? FEATURES[id];
// "Every plan includes" tiles, in the same style as "What's inside".
const included: { icon: string; name: string }[] = [
  { icon: 'dashboard', name: 'Manager & worker dashboards' },
  { icon: 'tasks', name: 'Tasks with photo proof' },
  { icon: 'timesheets', name: 'Timesheets: daywork & price work' },
  { icon: 'materials', name: 'Material requests' },
  { icon: 'drawings', name: 'Drawings & documents' },
  { icon: 'photos', name: 'Site photos' },
  { icon: 'messages', name: 'Messages per site' },
  { icon: 'programme', name: 'Build programme per site' },
  { icon: 'hsDocs', name: 'Health & safety sign-offs' },
  { icon: 'signIn', name: 'QR site sign-in & fire roll call' },
  { icon: 'accidents', name: 'Accident & near-miss reports' },
  { icon: 'csv', name: 'CSV exports' },
];
const comingSoon = (Object.keys(FEATURES) as FeatureId[]).filter((id) => FEATURES[id].status === 'coming-soon');


const featureList = ['Tasks with photo proof', 'Daywork and price work timesheets', 'Material requests and delivery tracking', 'Drawings labelled by version', 'Site photo library', 'Site group chats and direct messages', 'Health and safety documents with sign-off', 'QR site sign-in and fire roll call', 'Accident and near-miss reports', 'Manager dashboard', 'Push notifications', 'Your logo and colours'];
const vat = (price: string, unit?: string) => ({ '@type': unit ? 'UnitPriceSpecification' : 'PriceSpecification', price, priceCurrency: 'GBP', valueAddedTaxIncluded: true, ...(unit ? { unitText: unit } : {}) });
const offer = (name: string, price: string, desc: string, unit?: string) => ({ '@type': 'Offer', name, description: desc, price, priceCurrency: 'GBP', url: 'https://banksman.app/#pricing', availability: 'https://schema.org/InStock', priceSpecification: vat(price, unit) });

const schema = [{
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization', '@id': 'https://banksman.app/#organization', name: 'Banksman', url: 'https://banksman.app/',
      logo: 'https://banksman.app/assets/icon-512.png', email: 'dom@dm4u.ai', telephone: '+447508300353',
      description: 'Construction site management software for small and mid-size UK building firms, built by a working builder.',
      areaServed: { '@type': 'Country', name: 'United Kingdom' },
      founder: { '@type': 'Person', name: 'Dom Keady', jobTitle: 'CEO & founder' },
      employee: [{ '@type': 'Person', name: 'Dom Keady', jobTitle: 'CEO' }, { '@type': 'Person', name: 'Matt Guille', jobTitle: 'CMO' }],
      contactPoint: [
        { '@type': 'ContactPoint', contactType: 'sales', name: 'Dom Keady', telephone: '+447508300353', email: 'dom@dm4u.ai', areaServed: 'GB', availableLanguage: 'English' },
        { '@type': 'ContactPoint', contactType: 'sales', name: 'Matt Guille', telephone: '+447964660071', email: 'matt@dm4u.ai', areaServed: 'GB', availableLanguage: 'English' },
      ],
      parentOrganization: { '@type': 'Organization', name: 'DM.AI 4U Ltd' },
      sameAs: Object.values(SITE.social).filter(Boolean),
    },
    {
      '@type': 'SoftwareApplication', '@id': 'https://banksman.app/#software', name: 'Banksman', url: 'https://banksman.app/',
      applicationCategory: 'BusinessApplication', applicationSubCategory: 'Construction site management software',
      operatingSystem: 'Web, iOS, Android', inLanguage: 'en-GB',
      description: 'Construction site management app for UK builders: tasks with photo proof, timesheets, materials, drawings, site photos, messages, health and safety sign-offs, QR site sign-in and accident reports.',
      featureList, screenshot: ['https://banksman.app/assets/app/dashboard-desktop.webp', 'https://banksman.app/assets/app/dashboard-phone.webp'],
      publisher: { '@id': 'https://banksman.app/#organization' },
      offers: [
        offer('Starter', '79', 'Up to 10 users. Every feature.', 'MONTH'),
        offer('Growth', '149', 'Up to 25 users. Every feature, priority support.', 'MONTH'),
        offer('Enterprise', '299', 'Up to 75 users. Every feature, priority support.', 'MONTH'),
        offer('White label add-on', '999', 'One-off. Three 1-on-1 calls, exclusive features and a fully customised app, on top of any plan.'),
      ],
    },
    { '@type': 'WebSite', '@id': 'https://banksman.app/#website', name: 'Banksman', url: 'https://banksman.app/', inLanguage: 'en-GB', publisher: { '@id': 'https://banksman.app/#organization' } },
    {
      '@type': 'FAQPage', '@id': 'https://banksman.app/#faq',
      mainEntity: FAQ.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
    },
  ],
}];
---
<BaseLayout
  title={"Banksman: Construction site management software"}
  description={"Construction site management software built by a working builder. Tasks, timesheets, drawings, materials and site photos in one app. Try the live demo free."}
  schema={schema}
>
<!-- ================= HERO ================= -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">Construction site management software built in the UK, used worldwide</div>
        <h1>KILL THE PAPERWORK.<br><span>AND THE WHATSAPP.</span></h1>
        <p class="lede">Banksman keeps tasks, drawings, timesheets, materials and site photos in one app your whole team will <span class="hl-sky">actually use</span>, built by a working builder, not a software company that's never set foot on site.</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="#demo">Try the live demo →</a>
          <a class="btn btn-ghost" href="#pricing">See pricing</a>
        </div>
        <ul class="reassure">
          <li>Four fields and you're straight into the real app, no card, ever</li>
          <li>The working app on real site data, not a video tour</li>
          <li>Speak to Dom or Matt: real people, no bots or call centres</li>
        </ul>
      </div>

      <!-- Real screenshots from the app (manager dashboard). Files live in public/assets/app/. -->
      <HeroDevices />
    </div>
  </section>

  <!-- ================= COMPARISON ================= -->
  <section id="why">
    <div class="wrap">
      <div class="eyebrow">Why bother</div>
      <h2 class="big">Your site runs on paper and group chats.</h2>
      <div class="compare">
        <div class="compare-head">
          <div class="old">The old way</div>
          <div class="new">With Banksman</div>
        </div>
        <div class="compare-row">
          <div class="old">Lost paper plans and drawings three revisions out of date</div>
          <div class="new">Drawings on every phone, labelled by version and downloadable on site</div>
        </div>
        <div class="compare-row">
          <div class="old">Job updates and photos buried in a group chat</div>
          <div class="new">Tasks tracked per site, with photo proof against the job</div>
        </div>
        <div class="compare-row">
          <div class="old">Arguments about hours and overtime nobody wrote down</div>
          <div class="new">Daywork and price work logged on site, approved from the office</div>
        </div>
        <div class="compare-row">
          <div class="old">Enterprise software priced for a company with an IT department</div>
          <div class="new">From £79 a month inc. VAT</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= FEATURES ================= -->
  <section id="features">
    <div class="wrap">
      <div class="eyebrow">What's inside</div>
      <h2 class="big">Everything the site needs. One app.</h2>
      <div class="feat-grid">
        {headline.map((id) => (
          <div class="feat">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" set:html={ICONS[id]} />
            <h3>{featText(id).name}</h3>
            <p>{featText(id).summary}</p>
          </div>
        ))}
        <a class="feat feat-cta" href="#demo"><span>See it all for yourself</span><b>Try the live demo →</b></a>
      </div>
      <h3 class="feat-sub">The personal touch</h3>
      <ul class="feature-list">
        {extras.map((id) => (
          <li class="feature-item"><h3>{FEATURES[id].name}</h3><p>{FEATURES[id].summary}</p></li>
        ))}
      </ul>
      {comingSoon.length > 0 && (
        <>
          <h3 class="feat-sub">Coming soon</h3>
          <ul class="feature-list soon-list">
            {comingSoon.map((id) => (
              <li class="feature-item soon"><h3>{FEATURES[id].name}</h3><p>{FEATURES[id].summary}</p></li>
            ))}
          </ul>
        </>
      )}
    </div>
  </section>

  <!-- ================= LIVE DEMO ================= -->
  <section id="demo" class="demo-band">
    <div class="wrap demo-layout">
      <div class="demo-copy">
        <div class="eyebrow">No sales call needed</div>
        <h2 class="big" style="margin-bottom:10px;">See it live, right now.</h2>
        <p class="demo-lede">The actual app, running on realistic sample data: three live jobs, a team of six, real timesheets, materials requests and a build programme for every site. Log in as a manager or a worker and have a proper look around.</p>
        <p class="demo-lede">Four fields and your logins are on the next page. No card, no waiting for us to approve anything.</p>
      </div>

      <!-- Decorative: what's waiting in the demo -->
      <div class="demo-visual" aria-hidden="true">
        <div class="dv-head">
          <img class="dv-person" src="/assets/illustrations/worker-phone.svg" alt="" width="400" height="400" loading="lazy">
          <div class="dv-stats">
            <div class="dv-stat"><b>3</b><span>live jobs</span></div>
            <div class="dv-stat"><b>6</b><span>on the team</span></div>
            <div class="dv-stat"><b>2</b><span>logins</span></div>
          </div>
        </div>
        <div class="dv-card">
          <div class="dv-top"><img src="/assets/banksman-logo.png" alt="" width="216" height="35"><span class="dv-live"><i></i>Live demo</span></div>
          <div class="dv-label">Log in as</div>
          <div class="dv-roles">
            <div class="dv-role on">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="8" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="15" width="7" height="6" rx="1"/></svg>
              <b>Manager</b><small>Dashboard, approvals, orders</small>
            </div>
            <div class="dv-role">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 16a8 8 0 0 1 16 0"/><path d="M2.5 16h19v2.5h-19z"/><path d="M10 8.3V5.5h4v2.8"/></svg>
              <b>Worker</b><small>Tasks, hours, site sign-in</small>
            </div>
          </div>
          <div class="dv-label">Sample sites</div>
          <ul class="dv-sites">
            <li><div><b>Plot 4, Marsden Road</b><small>Slaithwaite</small></div><em>100%</em><span class="dv-bar"><i style="width:100%"></i></span></li>
            <li><div><b>Mill Lane Barn</b><small>Honley</small></div><em>20%</em><span class="dv-bar"><i style="width:20%"></i></span></li>
            <li><div><b>Station Road</b><small>Holmfirth</small></div><em>10%</em><span class="dv-bar"><i style="width:10%"></i></span></li>
          </ul>
        </div>
        <div class="dv-tag"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>No card. No sales call.</div>
      </div>

      <div class="demo-form">
        <div class="lead" id="lead">
          <form name="demo-access" method="POST" data-netlify="true" netlify-honeypot="company_website" action="/thanks.html">
            <input type="hidden" name="form-name" value="demo-access">
            <SpamGuard />
            <div class="lead-grid">
              <div class="field">
                <label for="name">Your name</label>
                <input id="name" name="name" type="text" autocomplete="name" required>
              </div>
              <div class="field">
                <label for="company">Company</label>
                <input id="company" name="company" type="text" autocomplete="organization" required>
              </div>
              <div class="field">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" autocomplete="email" required>
              </div>
              <div class="field">
                <label for="phone">Phone</label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" required>
              </div>
            </div>
            <label class="check"><input type="checkbox" name="marketing_opt_in" value="yes"> Send me occasional Banksman news, tips and offers by email. Unsubscribe any time.</label>
            <button class="btn btn-primary btn-block" type="submit">Unlock the live demo →</button>
            <p class="small-print" style="margin-top:14px;">Four fields. We only send marketing emails if you tick the box, and we never pass your details on, they come to us and nobody else. <a href="/privacy/">How we use your details</a>. Rather just talk? Ring Dom on <a href="tel:+447508300353" style="color:var(--accent);">07508 300353</a> or Matt on <a href="tel:+447964660071" style="color:var(--accent);">07964 660071</a>.</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PRICING ================= -->
  <section id="pricing">
    <div class="wrap">
      <div class="eyebrow">Pricing</div>
      <h2 class="big">No contracts, no nonsense.</h2>
      <div class="price-grid price-grid-3">
        <div class="quote">
          <div class="quote-head">
            <div class="mono">Starter</div>
            <div class="price">£79<span>/month inc. VAT</span></div>
            <div class="tier">Up to 10 users</div>
          </div>
          <ul>
            <li>Every feature in the app</li>
            <li>Manager and worker logins</li>
            <li>Optional onboarding call with us</li>
            <li>Support from Dom or Matt</li>
          </ul>
          <!-- STRIPE: Payment Link for the £79 monthly plan. After payment, redirect to /purchase-complete/?plan=starter -->
          <div class="foot"><a class="btn btn-ghost btn-block" href="https://buy.stripe.com/aFadR28IYdmH1Fea5N5sA07">Start Starter: £79/mo</a></div>
        </div>
        <div class="quote featured">
          <div class="quote-head">
            <div class="quote-top"><div class="mono">Growth</div><span class="quote-badge">Most popular</span></div>
            <div class="price">£149<span>/month inc. VAT</span></div>
            <div class="tier">Up to 25 users</div>
          </div>
          <ul>
            <li>Everything in Starter</li>
            <li>For larger teams across more sites</li>
            <li>Optional onboarding call with us</li>
            <li>Priority support, straight to Dom or Matt</li>
          </ul>
          <!-- STRIPE: Payment Link for the £149 monthly plan. After payment, redirect to /purchase-complete/?plan=growth -->
          <div class="foot"><a class="btn btn-primary btn-block" href="https://buy.stripe.com/aFa28k8IYgyT5Vu6TB5sA05">Start Growth: £149/mo</a></div>
        </div>
        <div class="quote">
          <div class="quote-head">
            <div class="mono">Enterprise</div>
            <div class="price">£299<span>/month inc. VAT</span></div>
            <div class="tier">Up to 75 users</div>
          </div>
          <ul>
            <li>Everything in Growth</li>
            <li>For bigger firms running lots of sites</li>
            <li>Promote workers to run their own sites</li>
            <li>Optional onboarding call with us</li>
            <li>Priority support, straight to Dom or Matt</li>
          </ul>
          <!-- Stripe Payment Link (£299 monthly). After payment it should redirect to /purchase-complete/?plan=enterprise -->
          <div class="foot"><a class="btn btn-ghost btn-block" href="https://buy.stripe.com/eVqdR2cZedmH2Ji91J5sA09">Start Enterprise: £299/mo</a></div>
        </div>
      </div>

      <div class="plan-includes">
        <div class="mono">Every plan includes</div>
        <ul class="inc-grid">
          {included.map((f) => (
            <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" set:html={ICONS[f.icon] ?? ''} /><span>{f.name}</span></li>
          ))}
        </ul>
        <p><strong>Onboarding call:</strong> once you've signed up, we'll email you a link to book a call with us at a time that suits you. It's optional, and it's free on every plan.</p>
      </div>

      <p class="price-note">Not sure which? Ring Dom on <a href="tel:+447508300353">07508 300353</a> or Matt on <a href="tel:+447964660071">07964 660071</a> and we'll tell you straight. It's usually Starter.</p>
      <p class="small-print">All prices include VAT. Cancel any time. Want a proper look before you pay? The live demo above takes four fields and no card.</p>
    </div>
  </section>

  <!-- ================= WHITE LABEL ================= -->
  <section class="whitelabel" id="white-label">
    <div class="wrap">
      <div class="wl-hero">
        <div class="wl-copy">
          <div class="wl-pill">White label add-on</div>
          <h2 class="wl-title">Your app.<br><span>Your name on it.</span></h2>
          <p class="wl-lede">Put your own app in front of your clients and your workforce. We don't just swap the logo, we sit down with you, learn how you run your jobs, and build the app around your business.</p>
          <div class="wl-price-row">
            <div class="wl-price">£999<span>one-off inc. VAT</span></div>
            <div class="wl-price-plus">+ your monthly plan<br><small>Starter £79 · Growth £149 · Enterprise £299</small></div>
          </div>
          <div class="hero-ctas">
            <!-- Stripe Payment Link (£999 one-off). After payment it should redirect to /purchase-complete/?plan=white-label -->
            <a class="btn btn-primary" href="https://buy.stripe.com/7sY7sE4sIbez4Rq2Dl5sA08">Get your own app →</a>
            <a class="btn btn-ghost" href="tel:+447508300353">Talk it through first</a>
          </div>
        </div>

        <!-- Illustration: the app wearing a customer's brand. Decorative. -->
        <div class="wl-visual" aria-hidden="true">
          <div class="wl-phone wl-real">
            <div class="phone-island"></div>
            <div class="phone-status"><span>9:41</span><span class="phone-status-icons"><i></i><i></i><i></i></span></div>
            <div class="shot-phone-top"><svg class="hb-logo" viewBox="0 0 120 24"><rect x="0" y="2" width="20" height="20" rx="5" fill="#2f6fdb"/><path d="M5 7v10M15 7v10M5 12h10" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/><text x="26" y="17" font-family="IBM Plex Sans, sans-serif" font-size="12.5" font-weight="700" fill="#f5f3ec" letter-spacing=".5">HARGREAVES</text></svg><span class="phone-icons"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg></span></div>
            <div class="st-body">
              <div class="st-crumb"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 6l-6 6 6 6"/></svg>Settings</div>
              <div class="st-title">Your branding</div>
              <div class="st-label">Company logo</div>
              <div class="st-upload"><svg class="hb-logo" viewBox="0 0 120 24"><rect x="0" y="2" width="20" height="20" rx="5" fill="#2f6fdb"/><path d="M5 7v10M15 7v10M5 12h10" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/><text x="26" y="17" font-family="IBM Plex Sans, sans-serif" font-size="12.5" font-weight="700" fill="#f5f3ec" letter-spacing=".5">HARGREAVES</text></svg><span>Replace</span></div>
              <div class="st-label">App icon</div>
              <div class="st-icons">
                <span class="st-icon"><svg viewBox="0 0 40 40"><rect width="40" height="40" rx="9" fill="#2f6fdb"/><path d="M13 12v16M27 12v16M13 20h14" stroke="#fff" stroke-width="3.4" stroke-linecap="round"/></svg></span>
                <div><b>Hargreaves Site</b><small>On every home screen</small></div>
              </div>
              <div class="st-label">Brand colour</div>
