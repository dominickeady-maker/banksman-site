---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FEATURES, type FeatureId } from '../data/features';
import '../styles/pages.css';

// Features section: names and descriptions come from src/data/features.ts, so edit them there.
const ICONS: Partial<Record<FeatureId, string>> = {
  dashboard: '<rect x="3" y="3" width="7" height="8" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="15" width="7" height="6" rx="1"/>',
  tasks: '<rect x="5" y="3" width="14" height="18" rx="1.5"/><path d="M9 3v2a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1V3"/><path d="M8 11h8M8 15h5"/>',
  timesheets: '<circle cx="12" cy="13" r="7.5"/><path d="M12 9v4l2.5 2M9 2h6"/>',
  materials: '<path d="M3 7l9-4 9 4-9 4-9-4Z"/><path d="M3 7v10l9 4 9-4V7M12 11v10"/>',
  drawings: '<path d="M6 3h9l4 4v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M15 3v4h4M8 12h8M8 16h5"/>',
  photos: '<rect x="3" y="6" width="18" height="14" rx="2"/><circle cx="12" cy="13" r="3.5"/><path d="M8 6l1.5-2.5h5L16 6"/>',
  messages: '<path d="M4 5h16v11H8l-4 4V5Z"/><path d="M8 9h8M8 12.5h5"/>',
  hsDocs: '<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6l8-3Z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
  signIn: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM18 18h3v3M21 14v1"/>',
};
const headline: FeatureId[] = ['dashboard', 'tasks', 'timesheets', 'materials', 'drawings', 'photos', 'messages', 'hsDocs', 'signIn'];
const extras = (Object.keys(FEATURES) as FeatureId[]).filter((id) => FEATURES[id].status === 'live' && !headline.includes(id));
const comingSoon = (Object.keys(FEATURES) as FeatureId[]).filter((id) => FEATURES[id].status === 'coming-soon');

// Ported from the static banksman.app home page (live-site/index.html).
const schema = [{"@context": "https://schema.org", "@graph": [{"@type": "Organization", "name": "Banksman", "url": "https://banksman.app", "logo": "https://banksman.app/assets/icon-512.png", "email": "dom@dm4u.ai", "telephone": "+447508300353", "contactPoint": [{"@type": "ContactPoint", "contactType": "sales", "name": "Dom Keady", "telephone": "+447508300353", "email": "dom@dm4u.ai", "areaServed": "GB"}, {"@type": "ContactPoint", "contactType": "sales", "name": "Matt Guille", "telephone": "+447964660071", "email": "matt@dm4u.ai", "areaServed": "GB"}], "parentOrganization": {"@type": "Organization", "name": "DM.AI 4U Ltd"}}, {"@type": "SoftwareApplication", "name": "Banksman", "applicationCategory": "BusinessApplication", "operatingSystem": "Web, iOS, Android", "url": "https://banksman.app", "description": "Construction site management app for UK builders: tasks, timesheets, materials, drawings, site photos and messages.", "offers": [{"@type": "Offer", "name": "Starter", "price": "79", "priceCurrency": "GBP", "priceSpecification": {"@type": "UnitPriceSpecification", "price": "79", "priceCurrency": "GBP", "unitText": "MONTH", "valueAddedTaxIncluded": true}}, {"@type": "Offer", "name": "Growth", "price": "149", "priceCurrency": "GBP", "priceSpecification": {"@type": "UnitPriceSpecification", "price": "149", "priceCurrency": "GBP", "unitText": "MONTH", "valueAddedTaxIncluded": true}}, {"@type": "Offer", "name": "Enterprise", "price": "299", "priceCurrency": "GBP", "priceSpecification": {"@type": "UnitPriceSpecification", "price": "299", "priceCurrency": "GBP", "unitText": "MONTH", "valueAddedTaxIncluded": true}}, {"@type": "Offer", "name": "White label add-on", "price": "999", "priceCurrency": "GBP", "priceSpecification": {"@type": "PriceSpecification", "price": "999", "priceCurrency": "GBP", "valueAddedTaxIncluded": true}}]}, {"@type": "WebSite", "name": "Banksman", "url": "https://banksman.app/"}]}];
---
<BaseLayout
  title={"Banksman — Construction site management software"}
  description={"Banksman is construction site management software built by a working builder. Tasks, drawings, timesheets, materials and site photos in one app your team will actually use. Try the live demo — no sign-up, no card."}
  schema={schema}
>
<!-- ================= HERO ================= -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">Site management software</div>
        <h1>KILL THE PAPERWORK.<br><span>AND THE WHATSAPP.</span></h1>
        <p class="lede">Banksman keeps tasks, drawings, timesheets, materials and site photos in one app your whole team will actually use — built by a working builder, not a software company that's never set foot on site.</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="#demo">Try the live demo →</a>
          <a class="btn btn-ghost" href="#pricing">See pricing</a>
        </div>
        <ul class="reassure">
          <li>Four fields and you're straight into the real app — no card, ever</li>
          <li>The working app on real site data, not a video tour</li>
          <li>Speak to Dom or Matt — real people, no bots or call centres</li>
        </ul>
      </div>

      <!-- Real screenshots from the app (manager dashboard). Files live in public/assets/app/. -->
      <div class="shots">
        <figure class="shot-desk">
          <div class="laptop-lid">
            <span class="laptop-cam" aria-hidden="true"></span>
            <div class="laptop-display">
              <div class="shot-bar" aria-hidden="true"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="shot-url">app.banksman.app</span></div>
              <div class="laptop-apphead" aria-hidden="true"><img src="/assets/banksman-logo.png" alt="" width="216" height="35"><span class="phone-icons"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg></span></div>
              <img class="laptop-shot" src="/assets/app/dashboard-desktop.webp" width="1400" height="746" alt="The Banksman manager dashboard on a laptop: tabs for tasks, workers, timesheets, materials, sites, drawings, photos, messages and health and safety, above today's numbers for who's on site, hours to approve and deliveries on the way" loading="eager" decoding="async">
            </div>
          </div>
          <div class="laptop-base" aria-hidden="true"><span></span></div>
        </figure>
        <figure class="shot-phone">
          <div class="phone-island" aria-hidden="true"></div>
          <div class="phone-status" aria-hidden="true"><span>9:41</span><span class="phone-status-icons"><i></i><i></i><i></i></span></div>
          <div class="shot-phone-top" aria-hidden="true">
            <img src="/assets/banksman-logo.png" alt="" width="216" height="35">
            <span class="phone-icons"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg></span>
          </div>
          <img class="phone-screen" src="/assets/app/dashboard-phone.webp" width="600" height="851" alt="The Banksman dashboard on a phone: who's on site, hours to approve, deliveries on the way, task counts and progress for each site" loading="eager" decoding="async">
          <img class="phone-nav" src="/assets/app/dashboard-phone-nav.webp" width="600" height="80" alt="" aria-hidden="true">
          <div class="phone-home" aria-hidden="true"></div>
        </figure>

        <!-- Live-feel notifications that cycle beside the phone. Decorative. -->
        <div class="hero-toasts" aria-hidden="true">
          <div class="toast t1"><span class="toast-ic ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg></span><div><b>Task done · photo attached</b><small>Plot 4, Marsden Road</small></div></div>
          <div class="toast t2"><span class="toast-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="13" r="7.5"/><path d="M12 9v4l2.5 2"/></svg></span><div><b>Hours approved</b><small>Danny H · 8.5 hrs daywork</small></div></div>
          <div class="toast t3"><span class="toast-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg></span><div><b>Delivery on the way</b><small>40 × dense blocks · 10:30</small></div></div>
          <div class="toast t4"><span class="toast-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><path d="M14 14h2v2h-2zM18 18h2v2"/></svg></span><div><b>Signed in on site</b><small>Mill Lane Barn, Honley</small></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= COMPARISON ================= -->
  <section id="why">
    <div class="wrap">
      <div class="eyebrow">Why bother</div>
      <h2 class="big">Your site runs on paper and group chats.</h2>
      <div class="compare">
        <div class="compare-head">
          <div class="old">The old way</div>
          <div class="new">With Banksman</div>
        </div>
        <div class="compare-row">
          <div class="old">Lost paper plans and drawings three revisions out of date</div>
          <div class="new">Drawings on every phone, labelled by version and downloadable on site</div>
        </div>
        <div class="compare-row">
          <div class="old">Job updates and photos buried in a group chat</div>
          <div class="new">Tasks tracked per site, with photo proof against the job</div>
        </div>
        <div class="compare-row">
          <div class="old">Arguments about hours and overtime nobody wrote down</div>
          <div class="new">Daywork and price work logged on site, approved from the office</div>
        </div>
        <div class="compare-row">
          <div class="old">Enterprise software priced for a company with an IT department</div>
          <div class="new">£79 a month inc. VAT, set up by the bloke who built it</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= FEATURES ================= -->
  <section id="features">
    <div class="wrap">
      <div class="eyebrow">What's inside</div>
      <h2 class="big">Everything the site needs. One app.</h2>
      <div class="feat-grid">
        {headline.map((id, i) => (
          <div class="feat">
            <div class="form-no">FORM {String(i + 1).padStart(2, '0')}</div>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" set:html={ICONS[id]} />
            <h3>{FEATURES[id].name}</h3>
            <p>{FEATURES[id].summary}</p>
          </div>
        ))}
      </div>
      <h3 class="feat-sub">Also in the app</h3>
      <ul class="feature-list">
        {extras.map((id) => (
          <li class="feature-item"><h3>{FEATURES[id].name}</h3><p>{FEATURES[id].summary}</p></li>
        ))}
      </ul>
      {comingSoon.length > 0 && (
        <div class="feat-soon">
          <span class="badge-soon">Coming soon</span>
          <ul class="chips">{comingSoon.map((id) => <li>{FEATURES[id].name}</li>)}</ul>
        </div>
      )}
      <p style="margin-top:20px; font-family:'IBM Plex Mono'; font-size:13px; color:var(--muted);">↳ Every table — timesheets, tasks, materials, drawings — exports straight to CSV for payroll, the accountant, or head office.</p>
    </div>
  </section>

  <!-- ================= LIVE DEMO ================= -->
  <section id="demo" class="demo-band">
    <div class="wrap">
      <div class="eyebrow">No sales call needed</div>
      <h2 class="big" style="margin-bottom:10px;">See it live, right now.</h2>
      <p style="color:var(--ink-soft); font-size:16px; max-width:58ch;">The actual app, running on realistic sample data — three live jobs, a six-man crew, real timesheets, materials requests and a build programme for every site. Log in as a manager or a worker and have a proper look around.</p>
      <p style="color:var(--ink-soft); font-size:16px; max-width:58ch; margin-top:10px;">Four fields and your logins are on the next page. No card, no waiting for me to approve anything.</p>

      <div class="lead" id="lead" style="margin-top:28px; max-width:720px;">
        <form name="demo-access" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thanks.html">
          <input type="hidden" name="form-name" value="demo-access">
          <p class="hp"><label>Leave this empty: <input name="bot-field"></label></p>
          <div class="lead-grid">
            <div class="field">
              <label for="name">Your name</label>
              <input id="name" name="name" type="text" autocomplete="name" required>
            </div>
            <div class="field">
              <label for="company">Company</label>
              <input id="company" name="company" type="text" autocomplete="organization" required>
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" autocomplete="email" required>
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" required>
            </div>
          </div>
          <label class="check"><input type="checkbox" name="walkthrough" value="yes"> Ring me as well and walk me through it on my own sites</label>
          <button class="btn btn-primary btn-block" type="submit">Unlock the live demo →</button>
          <p class="small-print" style="margin-top:14px;">Four fields, no newsletter, no passing your details on — they come to us and nobody else. <a href="/privacy/">How we use your details</a>. Rather just talk? Ring Dom on <a href="tel:+447508300353" style="color:var(--accent);">07508 300353</a> or Matt on <a href="tel:+447964660071" style="color:var(--accent);">07964 660071</a>.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- ================= PRICING ================= -->
  <section id="pricing">
    <div class="wrap">
      <div class="eyebrow">Pricing</div>
      <h2 class="big">No contracts, no nonsense.</h2>
      <div class="price-grid price-grid-3">
        <div class="quote">
          <div class="quote-head">
            <div class="mono">Starter</div>
            <div class="price">£79<span>/month inc. VAT</span></div>
            <div class="tier">Up to 10 users</div>
          </div>
          <ul>
            <li>Every feature in the app</li>
            <li>Manager and worker logins</li>
            <li>Optional onboarding call with us</li>
            <li>Support from Dom or Matt</li>
          </ul>
          <!-- STRIPE: Payment Link for the £79 monthly plan. After payment, redirect to /purchase-complete/?plan=starter -->
          <div class="foot"><a class="btn btn-ghost btn-block" href="https://buy.stripe.com/aFadR28IYdmH1Fea5N5sA07">Start Starter — £79/mo</a></div>
        </div>
        <div class="quote featured">
          <div class="quote-head">
            <div class="quote-top"><div class="mono">Growth</div><span class="quote-badge">Most popular</span></div>
            <div class="price">£149<span>/month inc. VAT</span></div>
            <div class="tier">Up to 25 users</div>
          </div>
          <ul>
            <li>Everything in Starter</li>
            <li>For larger teams across more sites</li>
            <li>Optional onboarding call with us</li>
            <li>Priority support — straight to Dom or Matt</li>
          </ul>
          <!-- STRIPE: Payment Link for the £149 monthly plan. After payment, redirect to /purchase-complete/?plan=growth -->
          <div class="foot"><a class="btn btn-primary btn-block" href="https://buy.stripe.com/aFa28k8IYgyT5Vu6TB5sA05">Start Growth — £149/mo</a></div>
        </div>
        <div class="quote">
          <div class="quote-head">
            <div class="mono">Enterprise</div>
            <div class="price">£299<span>/month inc. VAT</span></div>
            <div class="tier">Up to 75 users</div>
          </div>
          <ul>
            <li>Everything in Growth</li>
            <li>For bigger firms running lots of sites</li>
            <li>Optional onboarding call with us</li>
            <li>Priority support — straight to Dom or Matt</li>
          </ul>
          <!-- STRIPE: replace with the Payment Link for the £299 monthly plan. After payment, redirect to /purchase-complete/?plan=enterprise -->
          <div class="foot"><a class="btn btn-ghost btn-block" href="mailto:dom@dm4u.ai,matt@dm4u.ai?subject=Banksman%20Enterprise">Start Enterprise — £299/mo</a></div>
        </div>
      </div>

      <div class="plan-includes">
        <div class="mono">Every plan includes</div>
        <ul class="chips">
          <li>Tasks &amp; photo proof</li>
          <li>Timesheets — daywork &amp; price work</li>
          <li>Materials requests</li>
          <li>Drawings &amp; documents</li>
          <li>Site photos</li>
          <li>Messages per site</li>
          <li>Build programme per site</li>
          <li>Health &amp; safety sign-offs</li>
          <li>QR site sign-in &amp; fire roll call</li>
          <li>Accident &amp; near-miss reports</li>
        </ul>
        <p><strong>Onboarding call:</strong> once you've signed up, we'll email you a link to book a call with us at a time that suits you. It's optional, and it's free on every plan.</p>
      </div>

      <p class="price-note">Not sure which? Ring Dom on <a href="tel:+447508300353">07508 300353</a> or Matt on <a href="tel:+447964660071">07964 660071</a> and we'll tell you straight — it's usually Starter.</p>
      <p class="small-print">All prices include VAT. Cancel any time. Want a proper look before you pay? The live demo above takes four fields and no card.</p>
    </div>
  </section>

  <!-- ================= WHITE LABEL ================= -->
  <section class="whitelabel" id="white-label">
    <div class="wrap">
      <div class="wl-hero">
        <div class="wl-copy">
          <div class="wl-pill">White label add-on</div>
          <h2 class="wl-title">Your app.<br><span>Your name on it.</span></h2>
          <p class="wl-lede">Put your own app in front of your clients and your workforce. We don't just swap the logo — we sit down with you, learn how you run your jobs, and build the app around your business.</p>
          <div class="wl-price-row">
            <div class="wl-price">£999<span>one-off inc. VAT</span></div>
            <div class="wl-price-plus">+ your monthly plan<br><small>Starter £79 · Growth £149 · Enterprise £299</small></div>
          </div>
          <div class="hero-ctas">
            <!-- STRIPE: replace with the Payment Link for the £999 white label add-on. After payment, redirect to /purchase-complete/?plan=white-label -->
            <a class="btn btn-primary" href="mailto:dom@dm4u.ai,matt@dm4u.ai?subject=Banksman%20white%20label">Get your own app →</a>
            <a class="btn btn-ghost" href="tel:+447508300353">Talk it through first</a>
          </div>
        </div>

        <!-- Illustration: the app wearing a customer's brand. Decorative. -->
        <div class="wl-visual" aria-hidden="true">
          <div class="wl-phone">
            <div class="phone-island"></div>
            <div class="phone-status"><span>9:41</span><span class="phone-status-icons"><i></i><i></i><i></i></span></div>
            <div class="wl-phone-top">
              <div class="wl-logo-slot">YOUR LOGO</div>
              <div class="wl-avatar"></div>
            </div>
            <div class="wl-phone-body">
              <div class="wl-greet">Morning, Sam</div>
              <div class="wl-stat-row"><div><b>4</b><span>On site</span></div><div><b>2</b><span>To approve</span></div><div><b>1</b><span>Delivery</span></div></div>
              <div class="wl-card-mini"><div class="wl-line w70"></div><div class="wl-bar"><i style="width:72%"></i></div></div>
              <div class="wl-card-mini"><div class="wl-line w50"></div><div class="wl-bar"><i style="width:38%"></i></div></div>
              <div class="wl-card-mini exclusive"><span class="wl-tag">Built for you</span><div class="wl-line w60"></div><div class="wl-line w40 dim"></div></div>
              <div class="wl-task"><span class="wl-check on"></span><div class="wl-line w60"></div></div>
            </div>
            <div class="wl-phone-nav"><span></span><span></span><span></span><span></span></div>
            <div class="phone-home"></div>
          </div>
          <div class="wl-float wl-float-a"><span class="wl-swatch"></span><span class="wl-swatch s2"></span><span class="wl-swatch s3"></span><em>Your colours</em></div>
          <div class="wl-float wl-float-b"><b>yourcompany</b>.app</div>
        </div>
      </div>

      <div class="wl-how">
        <div class="wl-how-title mono">What you get</div>
        <ol class="wl-steps">
          <li>
            <div class="wl-num">01</div>
            <h3>Three 1-on-1 calls with Dom &amp; Matt</h3>
            <p>Time with the people who build Banksman, to get under the skin of your business, your sites and the problems you want solved.</p>
          </li>
          <li>
            <div class="wl-num">02</div>
            <h3>Exclusive features, built for you</h3>
            <p>We design and build features that fix your pain points — yours alone, not a setting everyone else has.</p>
          </li>
          <li>
            <div class="wl-num">03</div>
            <h3>A fully customised app</h3>
            <p>Your logo, your colours, your app icon, your name. Completely unique to you and your business.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ================= DM.AI 4U SERVICES ================= -->
  <section class="dmai" id="more-from-us">
    <div class="wrap">
      <div class="dmai-card">
        <div class="dmai-copy">
          <div class="eyebrow">More from the team</div>
          <h2 class="big">Impressed with Banksman? You should see what else we can do!</h2>
          <p class="dmai-lede"><strong>Banksman is part of DM.AI 4U.</strong> Speak to us about website development, web hosting, chatbots and automation. It's a bespoke service, from <b>£349/month inc. VAT</b> — mention it on your onboarding call.</p>
          <div class="hero-ctas">
            <a class="btn btn-primary" href="mailto:dom@dm4u.ai,matt@dm4u.ai?subject=DM.AI%204U%20services">Talk to us →</a>
          </div>
        </div>
        <ul class="dmai-services">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 8h18M8 21h8"/></svg>
            <b>Website development</b><span>Sites that win work, built and looked after for you.</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="3" width="16" height="7" rx="1.5"/><rect x="4" y="14" width="16" height="7" rx="1.5"/><path d="M8 6.5h.01M8 17.5h.01"/></svg>
            <b>Web hosting</b><span>Fast, secure hosting without the hassle.</span>
