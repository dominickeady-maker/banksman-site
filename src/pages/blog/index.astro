---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE } from '../../site';
import { getPosts, postUrl, formatDate, readingMinutes, coverUrl } from '../../lib/posts';
import { breadcrumbSchema } from '../../lib/schema';
import '../../styles/pages.css';

const posts = await getPosts();
const [featured, ...rest] = posts;
const categories = [...new Set(posts.map((p) => p.data.category))];
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');

const description = 'Practical articles for UK builders and contractors on running sites, managing crews, timesheets, materials and site paperwork.';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: `${SITE.name} blog`,
    url: `${SITE.url}/blog/`,
    description,
    blogPost: posts.filter((p) => !p.data.draft).map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: new URL(postUrl(p), SITE.url).href,
      datePublished: p.data.pubDate.toISOString().slice(0, 10),
      image: new URL(coverUrl(p), SITE.url).href,
    })),
  },
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog/' }]),
];
---
<BaseLayout title="Blog — site management tips for UK builders | Banksman" description={description} image="/og/blog.png" schema={schema} current="blog">
  <section class="page-head big-head blog-head"><div class="wrap">
    <div class="eyebrow">The Banksman blog</div>
    <h1>From the site, <span>not the sales team.</span></h1>
    <p>Straight-talking guides on running building sites, crews, timesheets and paperwork — written by a builder who's been there.</p>
  </div></section>

  <div class="wrap blog-wrap">
    {featured && (
      <a class="post-featured" href={postUrl(featured)}>
        <div class="pf-img"><img src={coverUrl(featured)} alt="" width="1200" height="675" loading="eager" /></div>
        <div class="pf-body">
          <div class="pf-top">
            <span class="pf-label">Latest</span>
            <span class="tag">{featured.data.category}</span>
            {featured.data.draft && <span class="draft-flag">Draft</span>}
          </div>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.description}</p>
          <span class="meta">{featured.data.author} · {formatDate(featured.data.pubDate)} · {readingMinutes(featured.body)} min read</span>
          <span class="pf-read">Read the article →</span>
        </div>
      </a>
    )}

    {categories.length > 1 && (
      <div class="blog-filter" role="group" aria-label="Filter by topic">
        <button type="button" class="chip on" data-filter="all" aria-pressed="true">All</button>
        {categories.map((c) => <button type="button" class="chip" data-filter={slugify(c)} aria-pressed="false">{c}</button>)}
      </div>
    )}

    <div class="post-grid post-grid-img">
      {rest.map((post) => (
        <a class="post-card" href={postUrl(post)} data-cat={slugify(post.data.category)}>
          <div class="pc-img"><img src={coverUrl(post)} alt="" width="1200" height="675" loading="lazy" /></div>
          <div class="pc-body">
            <span class="tag">{post.data.category}</span>
            {post.data.draft && <span class="draft-flag">Draft</span>}
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <span class="meta">{formatDate(post.data.pubDate)} · {readingMinutes(post.body)} min read</span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <CtaBand heading="See how it works on site." />
</BaseLayout>

<script is:inline>
  (function () {
    var chips = document.querySelectorAll('.blog-filter .chip');
    var cards = document.querySelectorAll('.post-grid-img .post-card');
    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        var f = chip.getAttribute('data-filter');
        chips.forEach(function (c) { var on = c === chip; c.classList.toggle('on', on); c.setAttribute('aria-pressed', on ? 'true' : 'false'); });
        cards.forEach(function (card) { card.hidden = f !== 'all' && card.getAttribute('data-cat') !== f; });
      });
    });
  })();
</script>

<style>
  .blog-wrap { padding-bottom: 20px; }
  .post-featured { display: grid; grid-template-columns: 1.5fr 1fr; background: var(--surface); border: 1px solid var(--line-strong); border-radius: 6px; overflow: hidden; text-decoration: none; transition: border-color .15s; }
  .post-featured:hover { border-color: var(--accent); }
  .pf-img img, .pc-img img { display: block; width: 100%; height: 100%; object-fit: cover; aspect-ratio: 16 / 9; transition: transform .3s; }
  .post-featured:hover .pf-img img, .post-card:hover .pc-img img { transform: scale(1.03); }
  .pf-img, .pc-img { overflow: hidden; background: #0d1120; }
  .pf-body { padding: 28px 30px 26px; display: flex; flex-direction: column; justify-content: center; }
  .pf-top { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .pf-label { font-family: 'IBM Plex Mono', monospace; font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; background: var(--accent); color: var(--accent-ink); padding: 3px 8px; border-radius: 3px; }
  .post-featured .tag { font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); }
  .post-featured h2 { font-size: clamp(28px, 3vw, 38px); line-height: 1.02; margin: 16px 0 12px; color: var(--ink); }
  .post-featured p { color: var(--ink-soft); font-size: 16.5px; margin: 0 0 18px; }
  .post-featured .meta { margin: 0; }
  .pf-read { margin-top: 22px; color: var(--accent); font-weight: 600; font-size: 15px; }
  @media (max-width: 820px) { .post-featured { grid-template-columns: 1fr; } .pf-body { padding: 24px 22px 26px; } }

  .blog-filter { display: flex; flex-wrap: wrap; gap: 8px; margin: 44px 0 20px; }
  .chip { font-family: 'IBM Plex Mono', monospace; font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; background: transparent; color: var(--ink-soft); border: 1px solid var(--line-strong); border-radius: 999px; padding: 8px 14px; cursor: pointer; }
  .chip:hover { border-color: var(--accent); color: var(--ink); }
  .chip.on { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }

  .post-grid-img { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 960px) { .post-grid-img { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .post-grid-img { grid-template-columns: 1fr; } }
  .post-grid-img .post-card { padding: 0; overflow: hidden; }
  .post-grid-img .post-card[hidden] { display: none; }
  .pc-body { padding: 20px 22px 22px; display: flex; flex-direction: column; flex: 1; }
  .pc-body .draft-flag { align-self: flex-start; margin-top: 8px; }
  .post-grid-img .post-card h2 { font-size: 25px; }
  .post-grid-img .post-card { position: relative; transition: transform .25s, box-shadow .25s, border-color .25s; }
  .post-grid-img .post-card::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 3px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform .3s; z-index: 2; }
  .post-grid-img .post-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .post-grid-img .post-card:hover::before { transform: scaleX(1); }
  .post-grid-img .post-card .tag, .post-featured .tag { display: inline-block; align-self: flex-start; border: 1px solid rgba(255,122,46,.5); border-radius: 999px; padding: 3px 10px; }
  .post-featured { border-top: 2px solid var(--accent); }
</style>
