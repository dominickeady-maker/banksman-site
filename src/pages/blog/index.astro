---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE } from '../../site';
import { getPosts, postUrl, formatDate, readingMinutes, coverUrl, coverAlt } from '../../lib/posts';
import { breadcrumbSchema } from '../../lib/schema';
import '../../styles/pages.css';

// Layout "Magazine": illustrated header with floating cards, a big featured post, then a card grid.
const posts = await getPosts();
const [featured, ...rest] = posts;
const categories = [...new Set(posts.map((p) => p.data.category))];
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');

// Each topic gets its own colour. Add a line here when a new category appears.
const TOPIC_COLOURS: Record<string, string> = {
  'Site management': '#ff7a2e',
  'Choosing software': '#4cc3ff',
  'Health and safety': '#3ccf6e',
  'Money and hours': '#ffd23f',
};
const SPARE = ['#3ccf6e', '#ffd23f', '#c6f432', '#a78bfa'];
const colour = (c: string) => TOPIC_COLOURS[c] ?? SPARE[Math.max(0, categories.indexOf(c)) % SPARE.length];

const description = 'Practical articles for UK builders and contractors on running sites, managing crews, timesheets, materials and site paperwork.';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: `${SITE.name} blog`,
    url: `${SITE.url}/blog/`,
    description,
    blogPost: posts.filter((p) => !p.data.draft).map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: new URL(postUrl(p), SITE.url).href,
      datePublished: p.data.pubDate.toISOString().slice(0, 10),
      image: new URL(coverUrl(p), SITE.url).href,
    })),
  },
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog/' }]),
];
---
<BaseLayout title="Blog: site management tips for UK builders | Banksman" description={description} image="/og/blog.png" schema={schema} current="blog">
  <section class="bl-head"><div class="wrap bl-head-grid">
    <div>
      <div class="eyebrow">The Banksman blog</div>
      <h1>From the site, <span>not the sales team.</span></h1>
      <p>Straight-talking guides on running building sites, crews, timesheets and paperwork, written by a builder who's been there.</p>
      {categories.length > 1 && (
        <div class="bl-topics" role="group" aria-label="Filter by topic">
          <button type="button" class="bl-topic on" data-filter="all" aria-pressed="true" style="--c:#4cc3ff">All</button>
          {categories.map((c) => <button type="button" class="bl-topic" data-filter={slugify(c)} aria-pressed="false" style={`--c:${colour(c)}`}>{c}</button>)}
        </div>
      )}
    </div>
    {featured && (
      <div class="bl-art" aria-hidden="true">
        <img class="bl-person" src="/assets/illustrations/manager-tablet.svg" alt="" width="400" height="400">
        <div class="bl-chip c1"><i style="background:#ff7a2e"></i><b>Latest post</b><small>{featured.data.title}</small></div>
        <div class="bl-chip c2"><i style="background:#4cc3ff"></i><b>{readingMinutes(featured.body)} min read</b><small>Read it on your break</small></div>
        <div class="bl-chip c3"><i style="background:#3ccf6e"></i><b>Written by builders</b><small>Not the sales team</small></div>
      </div>
    )}
  </div></section>

  <div class="wrap bl-wrap">
    {featured && (
      <a class="bl-feat" href={postUrl(featured)} style={`--c:${colour(featured.data.category)}`}>
        <div class="bl-feat-img"><img src={coverUrl(featured)} alt={coverAlt(featured)} width="1200" height="675" loading="eager" fetchpriority="high"></div>
        <div class="bl-feat-body">
          <div class="bl-feat-top"><span class="bl-tag">{featured.data.category}</span>{featured.data.draft && <span class="draft-flag">Draft</span>}</div>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.description}</p>
          <span class="bl-meta">{featured.data.author} · {formatDate(featured.data.pubDate)} · {readingMinutes(featured.body)} min read</span>
          <span class="bl-read">Read the article →</span>
        </div>
      </a>
    )}

    <div class="bl-grid">
      {rest.map((p) => (
        <a class="bl-card" href={postUrl(p)} data-cat={slugify(p.data.category)} style={`--c:${colour(p.data.category)}`}>
          <div class="bl-card-img"><img src={coverUrl(p)} alt={coverAlt(p)} width="1200" height="675" loading="lazy"><span class="bl-tag">{p.data.category}</span></div>
          <div class="bl-card-body">
            {p.data.draft && <span class="draft-flag">Draft</span>}
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
            <span class="bl-meta">{formatDate(p.data.pubDate)} · {readingMinutes(p.body)} min read</span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <CtaBand heading="See how it works on site." />
</BaseLayout>

<script is:inline>
  (function () {
    var chips = document.querySelectorAll('.bl-topic');
    var cards = document.querySelectorAll('.bl-card');
    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        var f = chip.getAttribute('data-filter');
        chips.forEach(function (c) { var on = c === chip; c.classList.toggle('on', on); c.setAttribute('aria-pressed', on ? 'true' : 'false'); });
        cards.forEach(function (card) { card.hidden = f !== 'all' && card.getAttribute('data-cat') !== f; });
      });
    });
  })();
</script>

<style>
  .bl-head{padding:70px 0 40px;}
  .bl-head-grid{display:grid; grid-template-columns:1.1fr .9fr; gap:40px; align-items:center;}
  .bl-head h1{font-size:clamp(40px,6vw,72px); line-height:.98; margin:14px 0 16px;}
  .bl-head h1 span{color:var(--accent);}
  .bl-head p{color:var(--ink-soft); font-size:18px; max-width:52ch;}
  .bl-topics{display:flex; flex-wrap:wrap; gap:8px; margin-top:22px;}
  .bl-topic{font:600 12px/1 'IBM Plex Mono',monospace; letter-spacing:.06em; text-transform:uppercase; padding:9px 13px; border-radius:999px; cursor:pointer; color:var(--c); border:1px solid color-mix(in srgb, var(--c) 55%, transparent); background:color-mix(in srgb, var(--c) 10%, transparent); transition:background .2s, color .2s;}
  .bl-topic:hover{background:color-mix(in srgb, var(--c) 22%, transparent);}
  .bl-topic.on{background:var(--c); color:#0b0e19; border-color:var(--c);}
  .bl-art{position:relative; height:400px;}
  .bl-person{position:absolute; right:40px; top:10px; width:330px; height:330px; filter:drop-shadow(0 24px 40px rgba(0,0,0,.5)); animation:rpBob 7s ease-in-out infinite;}
  .bl-chip{position:absolute; display:grid; grid-template-columns:auto 1fr; column-gap:10px; align-items:center; padding:10px 14px; background:rgba(23,28,48,.96); border:1px solid var(--line-strong); border-radius:10px; box-shadow:0 18px 40px rgba(0,0,0,.45); max-width:250px; animation:sttBob 6s ease-in-out infinite;}
  .bl-chip i{grid-row:span 2; width:10px; height:10px; border-radius:50%;}
  .bl-chip b{font-size:13.5px; color:var(--ink);}
  .bl-chip small{font-size:12px; color:var(--muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
  .bl-chip.c1{left:0; top:30px;} .bl-chip.c2{right:0; top:250px; animation-delay:-2s;} .bl-chip.c3{left:20px; bottom:10px; animation-delay:-4s;}
  .bl-wrap{padding-bottom:30px;}
  .bl-feat{display:grid; grid-template-columns:1.4fr 1fr; background:var(--surface); border:1px solid var(--line-strong); border-top:3px solid var(--c); border-radius:10px; overflow:hidden; text-decoration:none; color:inherit; transition:transform .25s, box-shadow .25s;}
  .bl-feat:hover{transform:translateY(-4px); box-shadow:var(--shadow);}
  .bl-feat-img, .bl-card-img{overflow:hidden; background:#0d1120;}
  .bl-feat-img img, .bl-card-img img{display:block; width:100%; height:100%; object-fit:cover; aspect-ratio:16/9; transition:transform .4s;}
  .bl-feat:hover img, .bl-card:hover img{transform:scale(1.03);}
  .bl-feat-body{padding:30px; display:flex; flex-direction:column; justify-content:center;}
  .bl-feat-top{display:flex; gap:10px; align-items:center; flex-wrap:wrap;}
  .bl-feat h2{font-size:clamp(28px,3vw,40px); line-height:1.02; margin:14px 0 12px;}
  .bl-feat p, .bl-card p{color:var(--ink-soft);}
  .bl-tag{align-self:flex-start; font:600 11px/1 'IBM Plex Mono',monospace; letter-spacing:.1em; text-transform:uppercase; color:#0b0e19; background:var(--c); padding:6px 9px; border-radius:999px;}
  .bl-meta{font-size:13px; color:var(--muted); margin-top:8px;}
  .bl-read{margin-top:18px; color:var(--c); font-weight:700;}
  .bl-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:22px; margin:34px 0 40px;}
  .bl-card{background:var(--surface); border:1px solid var(--line-strong); border-radius:10px; overflow:hidden; text-decoration:none; color:inherit; display:flex; flex-direction:column; transition:transform .25s, border-color .25s;}
  .bl-card[hidden]{display:none;}
  .bl-card:hover{transform:translateY(-4px); border-color:var(--c);}
  .bl-card-img{position:relative;}
  .bl-card-img .bl-tag{position:absolute; left:12px; top:12px;}
  .bl-card-body{padding:18px 20px 22px; display:flex; flex-direction:column; flex:1;}
  .bl-card-body .draft-flag{align-self:flex-start; margin-bottom:8px;}
  .bl-card h2{font-size:24px; line-height:1.05; margin:0 0 10px;}
  .bl-card .bl-meta{margin-top:auto; padding-top:10px;}
  @media (max-width:960px){
    .bl-head-grid{grid-template-columns:1fr;}
    .bl-art{height:330px; max-width:420px;}
    .bl-person{width:250px; height:250px; right:60px;}
    .bl-feat{grid-template-columns:1fr;}
    .bl-grid{grid-template-columns:1fr 1fr;}
  }
  @media (max-width:600px){
    .bl-grid{grid-template-columns:1fr;}
    .bl-art{height:300px;}
    .bl-person{right:20px; width:220px; height:220px;}
    .bl-chip.c2{top:200px;}
  }
  @media (prefers-reduced-motion: reduce){ .bl-person, .bl-chip{animation:none;} }
</style>
