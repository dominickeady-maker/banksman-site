---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpamGuard from '../components/SpamGuard.astro';
import { SITE } from '../site';
import { breadcrumbSchema } from '../lib/schema';
import '../styles/pages.css';

// Support requests go to Netlify Forms (form name "support"). Netlify emails Dom and Matt,
// and netlify/functions/submission-created.mjs files each one in Supabase (DM4U-CRM).
const REASONS = [
  { value: 'bug_report', label: 'Bug report' },
  { value: 'help_request', label: 'Help request' },
  { value: 'feature_suggestion', label: 'Feature suggestion' },
  { value: 'other', label: 'Other' },
];

const description = 'Get help with Banksman. Report a bug, ask for help or suggest a feature, and Dom or Matt will get back to you. Real people, no bots or call centres.';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Banksman support',
    url: `${SITE.url}/support/`,
    description,
    mainEntity: {
      '@id': `${SITE.url}/#organization`,
      contactPoint: SITE.contacts.map((c) => ({
        '@type': 'ContactPoint',
        contactType: 'customer support',
        name: c.name,
        telephone: c.phoneIntl,
        email: c.email,
        areaServed: 'GB',
        availableLanguage: 'English',
      })),
    },
  },
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Support', path: '/support/' }]),
];
---
<BaseLayout title="Banksman support: report a bug, get help or suggest a feature" description={description} schema={schema} current="support">
  <section class="page-head big-head"><div class="wrap">
    <div class="eyebrow">Support</div>
    <h1>Something not right? <span>Tell us.</span></h1>
    <p>Report a bug, ask for a hand or tell us what you'd like Banksman to do next. Every message goes straight to Dom and Matt: real people, no bots or call centres.</p>
  </div></section>

  <section class="support-section">
    <div class="wrap support-layout">
      <div class="lead support-form">
        <form name="support" method="POST" data-netlify="true" netlify-honeypot="company_website" action="/support/sent/">
          <input type="hidden" name="form-name" value="support">
          <SpamGuard />
          <div class="lead-grid">
            <div class="field">
              <label for="first_name">First name <span class="req" aria-hidden="true">*</span></label>
              <input id="first_name" name="first_name" type="text" autocomplete="given-name" required aria-required="true" minlength="1" maxlength="120">
            </div>
            <div class="field">
              <label for="last_name">Last name <span class="req" aria-hidden="true">*</span></label>
              <input id="last_name" name="last_name" type="text" autocomplete="family-name" required aria-required="true" maxlength="120">
            </div>
            <div class="field">
              <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" required aria-required="true" maxlength="254">
            </div>
            <div class="field">
              <label for="account_number">Account number <span class="opt">(optional)</span></label>
              <input id="account_number" name="account_number" type="text" inputmode="text" autocomplete="off" aria-describedby="acc-help">
              <small id="acc-help" class="field-help">On every invoice and every email from us. Not a customer yet? Leave it blank.</small>
            </div>
          </div>
          <div class="field">
            <label for="reason">What's it about? <span class="req" aria-hidden="true">*</span></label>
            <select id="reason" name="reason" required>
              <option value="" disabled selected>Choose one</option>
              {REASONS.map((r) => <option value={r.value}>{r.label}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="message">Tell us more <span class="req" aria-hidden="true">*</span></label>
            <textarea id="message" name="message" rows="6" required aria-required="true" minlength="10" maxlength="5000" placeholder="What happened, which screen you were on, and what you expected. A screenshot description helps too."></textarea>
          </div>
          <button class="btn btn-primary btn-block" type="submit">Send to Dom and Matt →</button>
          <p class="small-print"><span class="req">*</span> Required. We only use these details to answer you. <a href="/privacy/">How we use your details</a>.</p>
        </form>
      </div>

      <aside class="support-side">
        <!-- Decorative: a ticket moving through New, In progress and Done on a phone -->
        <div class="tk-wrap" aria-hidden="true">
          <div class="tk-phone">
            <div class="phone-island"></div>
            <div class="phone-status"><span>11:04</span><span class="phone-status-icons"><i></i><i></i><i></i></span></div>
            <div class="shot-phone-top"><img src="/assets/banksman-logo.png" alt="" width="216" height="35" loading="lazy"><span class="phone-icons"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg></span></div>
            <div class="tk-body">
              <div class="tk-title">Your requests</div>
              <div class="tk-card">
                <div class="tk-row"><b>Photos not uploading on site</b><span class="tk-chip done">Done</span></div>
                <small>Bug report · fixed in the latest update</small>
              </div>
              <div class="tk-card">
                <div class="tk-row"><b>Add a second site manager</b><span class="tk-chip prog">In progress</span></div>
                <small>Help request · Matt is on it</small>
              </div>
              <div class="tk-card">
                <div class="tk-row"><b>Plant checks for the dumper</b><span class="tk-chip new">New</span></div>
                <small>Feature suggestion · added to the list</small>
              </div>
              <div class="tk-dots"><i class="d1"></i><i class="d2"></i><i class="d3"></i><span>We reply to every one</span></div>
            </div>
            <div class="phone-home"></div>
          </div>
          <div class="tk-float"><span class="toast-ic ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg></span><div><b>Message received</b><small>Dom and Matt have it</small></div></div>
        </div>

        <div class="support-help">
          <h2>Rather talk?</h2>
          <ul class="support-contacts">
            {SITE.contacts.map((c) => (
              <li><b>{c.name}</b><a href={`tel:${c.phoneIntl}`}>{c.phone}</a><a href={`mailto:${c.email}`}>{c.email}</a></li>
            ))}
          </ul>
          <h3>Where's my account number?</h3>
          <p>It's printed on every invoice and at the bottom of every email we send you. It helps us find your account straight away.</p>
          <h3>Got an idea for the app?</h3>
          <p>Pick "Feature suggestion". Every one goes on the list we work from when we plan updates, and you can see what's landed on <a href="/whats-new/">What's new</a>.</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
