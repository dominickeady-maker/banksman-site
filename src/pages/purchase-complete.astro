---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site';

// Stripe sends customers here after payment. Set each Payment Link's "After payment" option to
// "Don't show confirmation page" and redirect to:
//   https://banksman.app/purchase-complete/?plan=starter      (£89/month)
//   https://banksman.app/purchase-complete/?plan=growth       (£149/month)
//   https://banksman.app/purchase-complete/?plan=enterprise   (£299/month)
//   https://banksman.app/purchase-complete/?plan=white-label  (£999 add-on)
// Links with the 14-day free trial add &trial=1 (e.g. ?plan=starter&trial=1): nothing has been
// charged, so the page says the trial has started instead of "your payment has gone through".
// The Meta Pixel "Purchase" event below reads the plan to send the right value.
// The page is noindex and blocked in robots.txt, so it never appears in Google.
---
<BaseLayout
  title="Thanks for signing up | Banksman"
  description="Thanks for signing up to Banksman. Here's what happens next."
  noindex
>
  <section class="page-head"><div class="wrap">
    <div class="eyebrow">You're in</div>
    <h1>Thanks for signing up.</h1>
    <p id="pc-plan-line">Your payment has gone through. Here's what happens next.</p>
  </div></section>

  <div class="wrap pc-wrap">
    <ol class="pc-steps">
      <li>
        <div class="pc-num">01</div>
        <div>
          <h2>Check your email</h2>
          <p id="pc-email-line">Your receipt from Stripe is on its way.</p>
        </div>
      </li>
      <li>
        <div class="pc-num">02</div>
        <div>
          <h2>Book your onboarding call (optional)</h2>
          <p>A free call with Dom or Matt to get your sites, team and drawings set up properly.</p>
          {SITE.bookingUrl && <a class="btn btn-primary" href={SITE.bookingUrl} target="_blank" rel="noopener">Book your onboarding call →</a>}
        </div>
      </li>
      <li>
        <div class="pc-num">03</div>
        <div>
          <h2>Get going</h2>
          <p>The app lives at <a href={SITE.appUrl}>app.banksman.app</a>. Bookmark it, or add it to your phone's home screen so it opens like any other app.</p>
        </div>
      </li>
    </ol>
    <p class="pc-help">{SITE.realPeople} <a href={SITE.contactUrl}>Request a call</a> and we'll ring you back.</p>
  </div>
</BaseLayout>

<!-- Names each plan on the page. -->
<script is:inline>
  (function () {
    var names = { starter: 'Starter', growth: 'Growth', enterprise: 'Enterprise', 'white-label': 'White label' };
    var q = new URLSearchParams(location.search);
    var plan = q.get('plan');
    var welcome = names[plan] ? 'Welcome to Banksman ' + names[plan] + '. ' : '';
    if (q.get('trial') === '1') {
      // Stripe takes the first payment 14 days after sign-up
      var ends = new Date(Date.now() + 14 * 86400000).toLocaleDateString('en-GB', { day: 'numeric', month: 'long' });
      document.getElementById('pc-plan-line').textContent = welcome + 'Your 14-day free trial has started — no payment until ' + ends + '. Here’s what happens next.';
      document.getElementById('pc-email-line').textContent = 'Your welcome email is on its way, with a link to set your password. Nothing has been charged: Stripe emails you a reminder before the trial ends, and you can cancel any time before ' + ends + ' in the app (More → Plan & billing).';
    } else if (welcome) {
      document.getElementById('pc-plan-line').textContent = welcome + 'Your payment has gone through. Here’s what happens next.';
    }
  })();
</script>

<!-- Meta Pixel Purchase event. Runs only once the visitor has accepted marketing cookies (Cookiebot). -->
<script is:inline type="text/plain" data-cookieconsent="marketing">
  (function () {
    var values = { starter: 89, growth: 149, enterprise: 299, 'white-label': 999 };
    var q = new URLSearchParams(location.search);
    var plan = q.get('plan');
    if (typeof fbq !== 'function') return;
    // A free trial hasn't been paid for yet: Meta's StartTrial event, with the monthly price as the predicted value
    if (q.get('trial') === '1') fbq('track', 'StartTrial', { value: values[plan] || 0, currency: 'GBP', predicted_ltv: values[plan] || 0, content_name: plan || 'unknown' });
    else fbq('track', 'Purchase', { value: values[plan] || 0, currency: 'GBP', content_name: plan || 'unknown' });
  })();
</script>

<style>
  .pc-wrap { padding-bottom: 80px; }
  .pc-steps, .pc-help { max-width: 760px; }
  .pc-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .pc-steps li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 18px; background: var(--surface); border: 1px solid var(--line-strong); border-radius: 6px; padding: 22px 24px; }
  .pc-num { font-family: 'Big Shoulders Display', sans-serif; font-weight: 800; font-size: 34px; line-height: 1; color: var(--accent); }
  .pc-steps h2 { font-family: 'IBM Plex Sans', system-ui, sans-serif; font-size: 18px; font-weight: 700; margin: 2px 0 6px; }
  .pc-steps p { margin: 0; color: var(--ink-soft); font-size: 15.5px; }
  .pc-steps p a { color: var(--accent); }
  .pc-steps .btn { margin-top: 14px; max-width: 100%; white-space: normal; text-align: center; }
  .pc-help { margin-top: 26px; color: var(--ink-soft); font-size: 15px; }
  .pc-help a { color: var(--accent); }
</style>
