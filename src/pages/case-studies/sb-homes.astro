---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import ExploreLinks from '../../components/ExploreLinks.astro';
import { SITE } from '../../site';
import { SB_HOMES as CS, casePath } from '../../data/case-studies';
import '../../styles/pages.css';

// Case study: SB Homes, a Colne Valley housebuilder, laid out as an interview with site manager Jamie.
// DRAFT: the answers were written from Matt's brief and must be approved by Jamie and SB Homes
// (with the photos) before this goes live. Keep claims qualitative unless SB Homes gives a real figure.
const URL_PATH = casePath(CS);
const PAGE_URL = `${SITE.url}${URL_PATH}`;
const CLIENT = { name: CS.client, url: CS.website, place: CS.place, work: CS.work, years: CS.years };
const niceDate = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

// Photos from the SB Homes website, credited on the page.
const PHOTO_DIR = '/assets/case-studies/sb-homes';
const CREDIT = 'Photo: SB Homes';
type Photo = { src: string; alt: string; caption: string };
const PHOTOS: Record<string, Photo> = {
  hero: { src: `${PHOTO_DIR}/stone-new-build.webp`, alt: CS.coverAlt, caption: 'A finished stone new build in the Colne Valley.' },
  aerial: { src: `${PHOTO_DIR}/development-aerial.webp`, alt: 'Aerial view of an SB Homes development under construction on a Colne Valley hillside', caption: 'A development mid build: lots of plots, lots of trades, one app.' },
  stone: { src: `${PHOTO_DIR}/stone-building-colne-valley.webp`, alt: 'Traditional stone building on a Colne Valley street, an SB Homes property', caption: 'Stone built, in the heart of the Colne Valley.' },
};

const WINS = [
  { k: 'Money saved', v: 'Fewer wasted orders, hours checked against each site, less time chasing', c: 'var(--accent)' },
  { k: 'A big team, organised', v: 'Who’s on which site and what they’re doing, without ringing round', c: 'var(--sky)' },
  { k: 'Every development on one screen', v: 'Progress, tasks and deliveries across every site at once', c: 'var(--accent)' },
  { k: 'Subbies and paperwork sorted', v: 'Sign in, RAMS and price work done on the phone', c: 'var(--sky)' },
];

const QA: { q: string; a: string[]; pull?: string; photo?: string }[] = [
  {
    q: 'Tell us about SB Homes and what you do there.',
    a: [
      'I’m a site manager at SB Homes. We’re a family housebuilder in the Colne Valley and we’ve been building since 1997, more than 500 homes so far. There are over 35 of us, plus the subbies, and there’s usually more than one development on the go.',
      'My job is keeping all of that moving: the right people on the right site, the materials there when they’re needed, and the work done properly.',
    ],
  },
  {
    q: 'What was running the sites like before Banksman?',
    a: [
      'A phone that never stopped. A WhatsApp group for every site, paper timesheets, deliveries booked by text and drawings in the cabin. It worked, just about, but you spent half the day finding out what was going on instead of running it.',
      'With a team our size, if you don’t know who’s where, you find out the hard way.',
    ],
    photo: 'aerial',
  },
  {
    q: 'What’s the biggest difference you’ve noticed?',
    pull: CS.quotes.expensive.text,
    a: [
      'The money we’ve saved. When you’ve got a big team across a few sites, small mistakes get expensive fast: an order placed twice, a delivery to the wrong site, hours nobody can check, a job done twice because someone was working from an old drawing.',
      'Banksman catches them before they cost us. Orders are approved before they’re placed, hours are logged against the site they were worked on, and everyone’s looking at the current drawing.',
    ],
  },
  {
    q: 'How do you keep a team that size organised?',
    pull: CS.quotes.whoswhere.text,
    a: [
      'Everyone signs in at the gate with the QR code, so I can see who’s on which site and what they’re doing without picking up the phone. Tasks are set for each site, so the team know their day before they arrive.',
      'If someone’s needed on another development, I can see who’s free and move them. That used to take a dozen phone calls.',
    ],
  },
  {
    q: 'And running several developments at once?',
    pull: CS.quotes.onescreen.text,
    a: [
      'Every development is on one screen: what’s done, what’s next, what’s been ordered and what’s arriving. I know where we’re up to before I’ve even left the house.',
      'When the office or a buyer asks how a plot’s getting on, I can tell them there and then, with photos.',
    ],
    photo: 'stone',
  },
  {
    q: 'What about the subcontractors?',
    pull: CS.quotes.subbies.text,
    a: [
      'They’re on it too. The subbies sign in, sign the RAMS and inductions and submit their price work on their phones. I approve it or query it, and it’s all written down.',
      'It’s all there when I need it, which matters on a housing site with a lot of different trades through the gate.',
    ],
  },
  {
    q: 'Was it hard to get everyone using it?',
    a: [
      'No. It works on the phone everyone already has, there’s nothing to install from an app store, and the team picked it up in a day or two. The ones who were least keen were the first to stop ringing me.',
    ],
  },
  {
    q: 'What would you tell another site manager?',
    a: [
      'If you’re running more than one site with a decent sized team, try it. Start with one development, get everyone signing in and logging their hours, and see how much less time you spend chasing.',
    ],
  },
];

const FEATURES = [
  { t: 'Site sign in', d: 'QR sign in at the gate and a live list of who’s on every site.' },
  { t: 'Tasks', d: 'Work set per site, so the team know their day before they arrive.' },
  { t: 'Timesheets', d: 'Hours logged against the site, approved in a tap, exported for payroll.' },
  { t: 'Materials', d: 'Requested by the team, approved before they’re ordered, tracked to the gate.' },
  { t: 'Price work', d: 'Subbies submit it, managers approve or dispute it.' },
  { t: 'RAMS and inductions', d: 'Read and signed on the phone, with proof of who signed what.' },
];

const title = 'Case study: SB Homes | Banksman';
const description = 'How SB Homes, a Colne Valley housebuilder, saves money and keeps a team of 35+ organised across several developments with Banksman.';

const photoObj = (key: string) => ({
  '@type': 'ImageObject',
  url: `${SITE.url}${PHOTOS[key].src}`,
  contentUrl: `${SITE.url}${PHOTOS[key].src}`,
  width: 1000,
  height: 750,
  caption: PHOTOS[key].caption,
  description: PHOTOS[key].alt,
  creditText: CS.shortName,
  copyrightHolder: { '@type': 'Organization', name: CS.client, url: CS.website },
});

const clientOrg = {
  '@type': 'Organization',
  '@id': `${PAGE_URL}#client`,
  name: CS.client,
  alternateName: CS.shortName,
  url: CS.website,
  sameAs: [CS.website],
  description: `Housebuilder in the ${CS.place}: ${CS.work.toLowerCase()}.`,
  foundingDate: '1997',
  numberOfEmployees: { '@type': 'QuantitativeValue', minValue: 35 },
  parentOrganization: { '@type': 'Organization', name: 'Byram Property Group' },
  areaServed: 'West Yorkshire',
  address: { '@type': 'PostalAddress', addressLocality: 'Huddersfield', addressRegion: 'West Yorkshire', addressCountry: 'GB' },
};

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': `${PAGE_URL}#article`,
    headline: CS.headline,
    alternativeHeadline: 'Case study: SB Homes on Banksman',
    description,
    abstract: CS.summary,
    url: PAGE_URL,
    mainEntityOfPage: { '@type': 'WebPage', '@id': PAGE_URL },
    inLanguage: 'en-GB',
    articleSection: 'Case studies',
    keywords: ['construction site management software', 'case study', 'SB Homes', 'housebuilder', 'Colne Valley', 'site manager', 'multiple sites', 'big teams', 'Banksman'],
    image: [`${SITE.url}/og/case-studies-sb-homes.png`, photoObj('hero'), photoObj('aerial'), photoObj('stone')],
    datePublished: CS.published,
    dateModified: CS.updated,
    author: { '@type': 'Person', name: 'Matt Guille', jobTitle: 'CMO', url: `${SITE.url}/meet-the-team/`, worksFor: { '@id': `${SITE.url}/#organization` } },
    publisher: { '@id': `${SITE.url}/#organization` },
    isPartOf: { '@type': 'CollectionPage', '@id': `${SITE.url}/case-studies/`, name: 'Banksman case studies' },
    about: [clientOrg, { '@type': 'SoftwareApplication', name: 'Banksman', applicationCategory: 'BusinessApplication', url: `${SITE.url}/` }],
    mentions: {
      '@type': 'Person',
      '@id': `${PAGE_URL}#jamie`,
      name: CS.person.name,
      jobTitle: 'Site manager',
      worksFor: { '@id': `${PAGE_URL}#client` },
    },
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.cs-summary p', '.cs-quick dd'] },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${PAGE_URL}#faq`,
    mainEntity: CS.quickAnswers.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Case studies', item: `${SITE.url}/case-studies/` },
      { '@type': 'ListItem', position: 3, name: CS.shortName, item: PAGE_URL },
    ],
  },
];

---
<BaseLayout
  title={title}
  description={description}
  schema={schema}
  current="case-studies"
  type="article"
  image="/og/case-studies-sb-homes.png"
  imageAlt="Case study: SB Homes on Banksman"
>
  <section class="cs-hero page-head"><div class="wrap cs-hero-grid">
    <div>
      <nav class="crumbs cs-crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/case-studies/">Case studies</a> / <span aria-current="page">{CS.shortName}</span></nav>
      <div class="eyebrow">Case study</div>
      <h1>SB Homes: <span>a big team, lots of sites, money saved.</span></h1>
      <p>SB Homes has been building family homes in the Colne Valley since 1997, with a team of over 35 and more than one development on the go. We sat down with site manager Jamie to ask how Banksman keeps it all organised, and what it saves them.</p>
      <div class="cs-meta">
        <span><b>Interview with</b> Jamie, site manager</span>
        <span><b>Firm</b> {CLIENT.name}</span>
        <span><b>Published</b> <time datetime={CS.published}>{niceDate(CS.published)}</time></span>
      </div>
    </div>
    <div class="cs-visual">
      <figure class="cs-hero-photo">
        <img src={PHOTOS.hero.src} alt={PHOTOS.hero.alt} width="1000" height="750" fetchpriority="high">
        <figcaption>{CREDIT}</figcaption>
      </figure>
      <div class="cs-phone" aria-hidden="true"><img src="/assets/app/dashboard-phone-360.webp" alt="" width="360" height="511" loading="lazy"></div>
      <div class="cs-chip cs-chip-1" aria-hidden="true"><i></i>Hours approved</div>
      <div class="cs-chip cs-chip-2" aria-hidden="true"><i></i>Order delivered</div>
    </div>
  </div></section>

  <section class="cs-client"><div class="wrap">
    <div class="cs-card">
      <div>
        <div class="cs-label">The client</div>
        <div class="cs-name">{CLIENT.name}</div>
        <div class="cs-place">{CLIENT.place} · {CLIENT.years}</div>
      </div>
      <p class="cs-work">{CLIENT.work}.</p>
      <a class="cs-site" href={CLIENT.url} target="_blank" rel="noopener">sbhomes.co.uk ↗<span class="sr-only"> (opens in a new tab)</span></a>
    </div>
    <div class="cs-summary">
      <h2 class="cs-label">In short</h2>
      <p>{CS.summary}</p>
    </div>
  </div></section>

  <section class="cs-wins"><div class="wrap">
    <div class="eyebrow">At a glance</div>
    <h2>What changed for SB Homes</h2>
    <ul class="cs-win-grid">
      {WINS.map((w) => <li style={`--c:${w.c}`}><b>{w.k}</b><span>{w.v}</span></li>)}
    </ul>
  </div></section>

  <section class="cs-interview"><div class="wrap cs-narrow">
    <div class="eyebrow">The interview</div>
    <h2>In Jamie’s words</h2>
    {QA.map((item) => (
      <div class="cs-qa">
        <h3 class="cs-q"><span>Banksman</span>{item.q}</h3>
        <div class="cs-a">
          <span class="cs-who" aria-hidden="true">J</span>
          <div>
            <span class="cs-a-name">Jamie</span>
            {item.a.map((para) => <p>{para}</p>)}
          </div>
        </div>
        {item.pull && <blockquote class="cs-pull"><p>“{item.pull}”</p><cite>Jamie, site manager, SB Homes</cite></blockquote>}
        {item.photo && (
          <figure class="cs-photo">
            <img src={PHOTOS[item.photo].src} alt={PHOTOS[item.photo].alt} width="1000" height="750" loading="lazy" decoding="async">
            <figcaption>{PHOTOS[item.photo].caption} <span>{CREDIT}</span></figcaption>
          </figure>
        )}
      </div>
    ))}
  </div></section>

  <section class="cs-quickwrap"><div class="wrap cs-narrow">
    <div class="eyebrow">Quick answers</div>
    <h2>SB Homes and Banksman: the facts</h2>
    <dl class="cs-quick">
      {CS.quickAnswers.map(({ q, a }) => <div><dt>{q}</dt><dd>{a}</dd></div>)}
    </dl>
  </div></section>

  <section class="cs-features"><div class="wrap">
    <div class="eyebrow">What SB Homes uses</div>
    <h2>The Banksman features behind it</h2>
    <ul class="cs-feat-grid">
      {FEATURES.map((f) => <li><b>{f.t}</b><span>{f.d}</span></li>)}
    </ul>
    <p class="cs-more"><a href="/#features">See every feature →</a> · <a href="/case-studies/">More case studies →</a> · <a href="/compare/">Banksman vs spreadsheets and WhatsApp →</a></p>
  </div></section>

  <ExploreLinks
    eyebrow="From the blog"
    title="Guides behind what SB Homes does."
    posts={['how-to-manage-site-inductions-and-rams-without-piles-of-paperwork', 'how-to-avoid-subcontractor-payment-disputes-a-guide-to-proof-of-work-on-site', 'get-your-building-site-off-whatsapp']}
    postCount={3}
    trades={['builders', 'groundworkers', 'subcontractors', 'scaffolders']}
    extra={[{ href: '/blog/', text: 'All guides on the blog' }, { href: '/compare/', text: 'Banksman vs spreadsheets & WhatsApp' }]}
  />

  <CtaBand heading="Run your sites like SB Homes." text="Have a look round the same app Jamie uses across every development, on realistic sample data. Four fields and your logins are on the next page. No card." />
</BaseLayout>

<style>
  .cs-hero-grid{display:grid; grid-template-columns:1.15fr .85fr; gap:50px; align-items:center;}
  .cs-hero h1 span{color:var(--accent);}
  .cs-meta{display:flex; flex-wrap:wrap; gap:10px 22px; margin-top:22px; font-size:14px; color:var(--ink-soft);}
  .cs-meta b{display:block; font:600 10.5px/1.4 'IBM Plex Mono',monospace; letter-spacing:.12em; text-transform:uppercase; color:var(--muted);}
  .cs-visual{position:relative; height:440px;}
  .cs-hero-photo{position:absolute; left:0; top:20px; width:88%; margin:0; border-radius:16px; overflow:hidden; border:1px solid var(--line-strong); box-shadow:0 30px 70px rgba(0,0,0,.5), 0 0 0 6px rgba(255,122,46,.22); rotate:-2deg;}
  .cs-hero-photo img{display:block; width:100%; height:auto;}
  .cs-hero-photo figcaption, .cs-photo figcaption span{font:600 10.5px/1.4 'IBM Plex Mono',monospace; letter-spacing:.08em; text-transform:uppercase;}
  .cs-hero-photo figcaption{position:absolute; right:10px; top:10px; background:rgba(13,17,32,.8); color:var(--ink-soft); padding:4px 8px; border-radius:4px;}
  .cs-phone{position:absolute; right:0; top:150px; width:170px; background:#0d101f; border:7px solid #161b2e; border-radius:34px; overflow:hidden; box-shadow:0 0 0 1.5px #2c3452, 0 30px 70px rgba(0,0,0,.55); rotate:-3deg; animation:csFloat 7s ease-in-out infinite;}
  .cs-phone img{display:block; width:100%; height:auto;}
  .cs-photo{margin:22px 0 4px 60px;}
  .cs-photo img{display:block; width:100%; height:auto; border-radius:12px; border:1px solid var(--line-strong); box-shadow:var(--shadow);}
  .cs-photo figcaption{margin-top:9px; font-size:13.5px; color:var(--muted); display:flex; flex-wrap:wrap; justify-content:space-between; gap:6px 14px;}
  .cs-photo figcaption span{color:var(--sky);}
  .cs-chip{position:absolute; display:flex; align-items:center; gap:9px; padding:10px 14px; background:rgba(23,28,48,.97); border:1px solid var(--line-strong); border-left:3px solid var(--c); border-radius:10px; box-shadow:0 18px 40px rgba(0,0,0,.45); font-size:13.5px; font-weight:600; animation:csFloat 6s ease-in-out infinite;}
  .cs-chip i{width:9px; height:9px; border-radius:50%; background:var(--c); box-shadow:0 0 10px var(--c);}
  .cs-chip-1{--c:var(--accent); left:-14px; top:0; animation-delay:-2s;}
  .cs-chip-2{--c:var(--sky); left:24px; bottom:18px; animation-delay:-4s;}

  .cs-crumbs{display:block; margin-bottom:18px;}
  .sr-only{position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0;}
  .cs-summary{margin-top:22px; max-width:78ch; background:var(--surface); border:1px solid var(--line-strong); border-left:3px solid var(--sky); border-radius:8px; padding:18px 22px;}
  .cs-summary h2{margin:0 0 6px; font-size:11px;}
  .cs-summary p{margin:0; color:var(--ink-soft); font-size:15.5px;}
  .cs-quickwrap{padding:30px 0 10px;}
  .cs-quickwrap h2{font-size:clamp(28px,3.6vw,40px); line-height:1.05; margin:10px 0 18px;}
  .cs-quick{margin:0; display:grid; gap:12px;}
  .cs-quick div{background:var(--surface); border:1px solid var(--line); border-radius:8px; padding:16px 20px;}
  .cs-quick dt{font-weight:700; font-size:16.5px; margin-bottom:6px;}
  .cs-quick dd{margin:0; color:var(--ink-soft); font-size:15.5px;}
  .cs-client{padding:20px 0 10px;}
  .cs-card{display:grid; grid-template-columns:auto 1fr auto; gap:28px; align-items:center; background:var(--surface); border:1px solid var(--line-strong); border-top:2px solid var(--accent); border-radius:8px; padding:24px 28px; box-shadow:var(--shadow);}
  .cs-label, .cs-a-name{font:600 11px/1.4 'IBM Plex Mono',monospace; letter-spacing:.12em; text-transform:uppercase; color:var(--sky);}
  .cs-name{font:800 28px/1.05 'Big Shoulders Display',sans-serif; margin:6px 0 4px;}
  .cs-place{font-size:14px; color:var(--muted);}
  .cs-work{margin:0; color:var(--ink-soft); font-size:15px; border-left:1px solid var(--line); padding-left:28px;}
  .cs-site{color:var(--accent); text-decoration:none; font-weight:600; font-size:14.5px; white-space:nowrap;}
  .cs-site:hover{text-decoration:underline;}
  .cs-note{max-width:78ch; margin:18px 0 0; color:var(--ink-soft); font-size:15px;}
  .cs-note b{color:var(--ink);}

  .cs-wins, .cs-features{padding:50px 0 20px;}
  .cs-wins h2, .cs-features h2, .cs-interview h2{font-size:clamp(30px,4vw,44px); line-height:1.05; margin:10px 0 22px;}
  .cs-win-grid{list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(4,1fr); gap:14px;}
  .cs-win-grid li{background:var(--surface); border:1px solid var(--line-strong); border-top:3px solid var(--c); border-radius:8px; padding:18px; display:grid; gap:6px; transition:transform .25s, border-color .25s;}
  .cs-win-grid li:hover{transform:translateY(-3px);}
  .cs-win-grid b{font:800 23px/1.05 'Big Shoulders Display',sans-serif; color:var(--c);}
  .cs-win-grid span{color:var(--ink-soft); font-size:14.5px;}

  .cs-interview{padding:50px 0 30px;}
  .cs-narrow{max-width:820px;}
  .cs-qa{padding:26px 0; border-top:1px solid var(--line);}
  .cs-q{font:800 clamp(22px,2.6vw,28px)/1.15 'Big Shoulders Display',sans-serif; color:var(--ink); margin:0 0 16px;}
  .cs-q span{display:block; font:600 11px/1.4 'IBM Plex Mono',monospace; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); margin-bottom:6px;}
  .cs-a{display:grid; grid-template-columns:44px 1fr; gap:16px;}
  .cs-who{width:44px; height:44px; border-radius:50%; display:grid; place-items:center; background:var(--accent-soft); border:1px solid rgba(255,122,46,.55); color:var(--accent); font:800 17px/1 'Big Shoulders Display',sans-serif;}
  .cs-a-name{color:var(--accent); display:block; margin:2px 0 6px;}
  .cs-a p{color:var(--ink-soft); font-size:16.5px; margin:0 0 12px;}
  .cs-pull{margin:16px 0 4px 60px; padding:22px 26px; border-left:3px solid var(--sky); border-radius:0 10px 10px 0; background:radial-gradient(500px 200px at 100% 0%, rgba(76,195,255,.12), transparent 70%), var(--surface);}
  .cs-pull p{margin:0; font:700 clamp(22px,2.6vw,29px)/1.2 'Big Shoulders Display',sans-serif; color:var(--ink);}
  .cs-pull cite{display:block; margin-top:10px; font-style:normal; font-size:13.5px; color:var(--sky);}

  .cs-feat-grid{list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line); border:1px solid var(--line); border-top:2px solid var(--accent); border-radius:4px; overflow:hidden;}
  .cs-feat-grid li{background:var(--surface); padding:18px 20px; display:grid; gap:4px;}
  .cs-feat-grid b{font-size:16px;}
  .cs-feat-grid span{color:var(--ink-soft); font-size:14.5px;}
  .cs-more{margin-top:18px; font-size:15px; color:var(--muted);}
  .cs-more a{color:var(--accent); text-decoration:none; font-weight:600;}
  .cs-more a:hover{text-decoration:underline;}

  @keyframes csFloat{0%,100%{translate:0 0;} 50%{translate:0 -7px;}}
  .cs-phone{animation-name:csFloatPhone;}
  @keyframes csFloatPhone{0%,100%{translate:0 0;} 50%{translate:0 -8px;}}
  @media (max-width:900px){
    .cs-hero-grid{grid-template-columns:1fr; gap:20px;}
    .cs-visual{height:auto; max-width:520px; width:100%; margin:10px auto 0; padding-bottom:30px;}
    .cs-hero-photo{position:relative; top:0; width:86%;}
    .cs-phone{width:130px; top:auto; bottom:0;}
    .cs-card{grid-template-columns:1fr; gap:14px;}
    .cs-work{border-left:0; padding-left:0; border-top:1px solid var(--line); padding-top:14px;}
    .cs-win-grid{grid-template-columns:1fr 1fr;}
    .cs-feat-grid{grid-template-columns:1fr 1fr;}
  }
  @media (max-width:560px){
    .cs-win-grid, .cs-feat-grid{grid-template-columns:1fr;}
    .cs-a{grid-template-columns:1fr; gap:6px;}
    .cs-who{display:none;}
    .cs-pull, .cs-photo{margin-left:0;}
    .cs-chip{font-size:12px; padding:8px 11px;} .cs-chip-1{display:none;}
  }
