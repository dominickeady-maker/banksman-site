---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE } from '../../site';
import { CASE_STUDIES, casePath } from '../../data/case-studies';
import '../../styles/pages.css';

// The list of customer case studies. New ones are added in src/data/case-studies.ts.
const PAGE_URL = `${SITE.url}/case-studies/`;
const featured = (c: (typeof CASE_STUDIES)[number]) => Object.values(c.quotes).find((q) => q.featured) ?? Object.values(c.quotes)[0];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': PAGE_URL,
    name: 'Banksman case studies',
    description: 'How UK building firms run their sites on Banksman, in their own words.',
    url: PAGE_URL,
    inLanguage: 'en-GB',
    isPartOf: { '@id': `${SITE.url}/#website` },
    publisher: { '@id': `${SITE.url}/#organization` },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: CASE_STUDIES.map((c, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}${casePath(c)}`, name: c.headline })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Case studies', item: PAGE_URL },
    ],
  },
];
---
<BaseLayout
  title="Banksman case studies: UK builders in their own words"
  description="How UK building firms run their sites on Banksman: timesheets, material orders and site progress, told by the people who use it every day."
  schema={schema}
  image="/og/case-studies.png"
  imageAlt="Banksman case studies"
>
  <section class="page-head csl-head"><div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">Case studies</span></nav>
    <div class="eyebrow">Case studies</div>
    <h1>Proof from the site, <span>not the brochure.</span></h1>
    <p>How building firms run their sites on Banksman, what changed and what it saves them. No made up logos, just real firms and the people who run them.</p>
  </div></section>

  <section class="csl"><div class="wrap">
    <ul class="csl-grid">
      {CASE_STUDIES.map((c) => (
        <li>
          <a class="csl-card" href={casePath(c)}>
            <img src={c.cover} alt={c.coverAlt} width="1000" height="750" loading="lazy" decoding="async">
            <div class="csl-body">
              <div class="csl-meta">{c.place} · {c.years}</div>
              <h2>{c.shortName}</h2>
              <blockquote>“{featured(c).text}”</blockquote>
              <p class="csl-who">{c.person.name}</p>
              <span class="csl-more">Read the case study →</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div></section>

  <CtaBand />
</BaseLayout>

<style>
  .csl-head h1 span{color:var(--accent);}
  .csl-head .crumbs{display:block; margin-bottom:18px;}
  .csl{padding:20px 0 50px;}
  .csl-grid{list-style:none; margin:0; padding:0; display:grid; grid-template-columns:1fr; gap:22px; max-width:1000px;}
  .csl-card{display:grid; grid-template-columns:1fr; height:100%; background:var(--surface); border:1px solid var(--line-strong); border-top:2px solid var(--accent); border-radius:10px; overflow:hidden; color:inherit; text-decoration:none; box-shadow:var(--shadow); transition:transform .25s, border-color .25s;}
  .csl-card:hover{transform:translateY(-3px); border-color:var(--accent);}
  .csl-card img{display:block; width:100%; height:100%; aspect-ratio:4/3; object-fit:cover;}
  @media (min-width:800px){ .csl-card{grid-template-columns:1fr 1fr; align-items:center;} .csl-body{padding:28px 32px;} }
  .csl-body{padding:20px 22px 22px;}
  .csl-meta{font:600 11px/1.4 'IBM Plex Mono',monospace; letter-spacing:.1em; text-transform:uppercase; color:var(--sky);}
  .csl-body h2{font-size:30px; line-height:1.05; margin:8px 0 10px;}
  .csl-body blockquote{margin:0; font:700 21px/1.25 'Big Shoulders Display',sans-serif; color:var(--ink);}
  .csl-who{margin:10px 0 0; color:var(--muted); font-size:14px;}
  .csl-more{display:inline-block; margin-top:14px; color:var(--accent); font-weight:600;}
</style>
