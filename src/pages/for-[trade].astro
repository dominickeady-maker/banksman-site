---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureList from '../components/FeatureList.astro';
import CtaBand from '../components/CtaBand.astro';
import HeroDevices from '../components/HeroDevices.astro';
import FaqPhones from '../components/FaqPhones.astro';
import SiteToasts from '../components/SiteToasts.astro';
import ExploreLinks from '../components/ExploreLinks.astro';
import { tradePosts } from '../data/links';
import { SITE } from '../site';
import { TRADES, type Trade } from '../data/trades';
import { FEATURES, type FeatureId } from '../data/features';
import { breadcrumbSchema } from '../lib/schema';
import '../styles/pages.css';

// One page per trade: /for-builders/, /for-bricklayers/ and so on. The copy lives in src/data/trades.ts.
export function getStaticPaths() {
  return TRADES.map((trade) => ({ params: { trade: trade.slug }, props: { trade } }));
}

const { trade } = Astro.props as { trade: Trade };
const path = `/for-${trade.slug}/`;

// Headline in two tones like the home page: the ending of each headline goes orange.
const ACCENT: Record<string, string> = {
  builders: 'what’s happening on all of them.',
  bricklayers: 'not on the back of a fag packet.',
  groundworkers: 'before it’s backfilled.',
  roofers: 'from the ground.',
  electricians: 'before the boards go up.',
  plumbers: 'for one fitting.',
  subcontractors: 'and have the proof when they query it.',
  'worktop-fitters': 'and have a photo of every stage.',
  'fit-out-contractors': 'with every snag signed off and photographed.',
  scaffolders: 'with the photos to prove it.',
  joiners: 'without chasing the timber or the drawings.',
  'steel-erectors': 'and a photo of every connection.',
  'window-fitters': 'and prove it was sealed right.',
};
const tail = ACCENT[trade.slug] && trade.h1.endsWith(ACCENT[trade.slug]) ? ACCENT[trade.slug] : '';
const h1Lead = tail ? trade.h1.slice(0, -tail.length).trim() : trade.h1;
const h1Accent = tail;

// Features the fixes use, then the extras. A feature on the "on the way" list joins the main list once it's live.
const fixIds = trade.pains.flatMap((p) => p.features);
const soon = trade.onTheWay.filter((id) => FEATURES[id].status === 'coming-soon');
const nowLive = trade.onTheWay.filter((id) => FEATURES[id].status === 'live');
const liveIds = [...new Set<FeatureId>([...fixIds, ...trade.alsoUseful, ...nowLive])];

const schema = [
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: `For ${trade.name.toLowerCase()}`, path }]),
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE.url}${path}`,
    url: `${SITE.url}${path}`,
    name: trade.title,
    description: trade.description,
    inLanguage: 'en-GB',
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: {
      '@type': 'SoftwareApplication',
      '@id': `${SITE.url}/#software`,
      name: 'Banksman',
      applicationCategory: 'BusinessApplication',
      audience: { '@type': 'BusinessAudience', audienceType: trade.name, geographicArea: { '@type': 'Country', name: 'United Kingdom' } },
      featureList: liveIds.map((id) => FEATURES[id].name),
    },
  },
  ...(trade.faq.length ? [{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: trade.faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  }] : []),
];
---
<BaseLayout title={trade.title} description={trade.description} image={`/og/for-${trade.slug}.png`} imageAlt={trade.ogTitle} schema={schema}>
  <section class="hero trade-hero">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">{trade.eyebrow}</div>
        <h1>{h1Lead} <span>{h1Accent}</span></h1>
        <p class="lede">{trade.lede}</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href={SITE.demoUrl}>Try the live demo →</a>
          <a class="btn btn-ghost" href="/compare/">How it compares</a>
        </div>
        <ul class="reassure">
          <li>Four fields and you're straight into the real app, no card, ever</li>
          <li>Every plan includes every feature, from £79/month inc. VAT</li>
          <li>Speak to Dom or Matt: real people, no bots or call centres</li>
        </ul>
      </div>
      <HeroDevices />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="eyebrow">Sound familiar?</div>
      <h2 class="big">{trade.painsHeading}</h2>
      <ol class="pain-list">
        {trade.pains.map((pain) => (
          <li class="pain">
            <div class="old">
              <div class="label">The problem</div>
              <h3>{pain.problem}</h3>
              <p>{pain.detail}</p>
            </div>
            <div class="new">
              <div class="label">With Banksman</div>
              <p>{pain.fix}</p>
              <ul class="chips" aria-label="Features used">
                {pain.features.map((id) => <li>{FEATURES[id].name}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-top">
        <div>
          <div class="eyebrow">In the app today</div>
          <h2 class="big">What you get.</h2>
        </div>
        <SiteToasts />
      </div>
      <FeatureList ids={liveIds} />
      {trade.tool && <p class="tool-link"><a href={trade.tool.href}>{trade.tool.text}</a></p>}
    </div>
  </section>

  {soon.length > 0 && (
    <section>
      <div class="wrap">
        <div class="eyebrow">On the way</div>
        <h2 class="big">Being built now.</h2>
        <p class="section-note">These aren't in the app yet. They're marked "Coming soon" until they are.</p>
        <FeatureList ids={soon} />
      </div>
    </section>
  )}

  <ExploreLinks
    eyebrow={`Guides for ${trade.name.toLowerCase()}`}
    title="Worth a read."
    posts={tradePosts(trade.slug)}
    tools={['/tools/day-rate-calculator/', '/tools/cis-calculator/']}
    extra={[{ href: '/compare/', text: 'Banksman vs spreadsheets & WhatsApp' }, { href: '/whats-new/', text: "What's new in the app" }]}
  />

  <section class="other-trades">
    <div class="wrap">
      <div class="eyebrow">Banksman for other trades</div>
      <ul class="trade-links">
        {TRADES.filter((t) => t.slug !== trade.slug).map((t) => <li><a href={`/for-${t.slug}/`}>{t.name} →</a></li>)}
        <li><a href="/compare/">vs spreadsheets &amp; WhatsApp →</a></li>
      </ul>
    </div>
  </section>

  {trade.faq.length > 0 && (
    <section class="home-faq trade-faq" id="faq">
      <div class="wrap faq-wrap">
        <div class="faq-side">
          <div class="eyebrow">{trade.name}: questions</div>
          <h2 class="big">Straight answers.</h2>
          <FaqPhones />
        </div>
        <div class="faq-list">
          {trade.faq.map(({ q, a }, i) => (
            <details open={i === 0}>
              <summary><h3>{q}</h3></summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand heading={trade.ctaHeading} />
</BaseLayout>
