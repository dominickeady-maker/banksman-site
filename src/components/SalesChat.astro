---
// "Ask about Banksman": an AI chat that answers questions about Banksman from the site's own
// details (src/pages/chat-knowledge.json.ts), through the sales-chat function. When someone wants a
// person, it shows a short form that goes to Netlify Forms as "chat-lead" and from there to the
// CRM (netlify/functions/submission-created.mjs). Shown on every page once SITE.salesChat.live is
// true; before that only on a page opened with ?chat=1.
import { SITE } from '../site';
import SpamGuard from './SpamGuard.astro';
const SUGGESTIONS = ['How much is it?', 'Which plan do I need?', 'Can I try it first?', 'Does it do health and safety?'];
---
<div class="bmc" data-bmc data-endpoint={SITE.salesChat.endpoint} data-live={SITE.salesChat.live ? '1' : '0'} hidden>
  <button type="button" class="bmc-open" data-bmc-open aria-expanded="false" aria-controls="bmc-panel">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 5h16v11H8l-4 4V5Z"/><path d="M8 9h8M8 12.5h5"/></svg>
    <span>Ask about Banksman</span>
  </button>

  <div class="bmc-panel" id="bmc-panel" role="dialog" aria-modal="false" aria-labelledby="bmc-title" hidden>
    <header class="bmc-head">
      <div>
        <h2 id="bmc-title">Banksman assistant</h2>
        <p>AI chat. Answers come from banksman.app and can be wrong, so check the important stuff with Dom or Matt.</p>
      </div>
      <button type="button" class="bmc-x" data-bmc-close aria-label="Close the chat">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </header>

    <div class="bmc-log" data-bmc-log aria-live="polite">
      <div class="bmc-msg bmc-bot">Hi, I can answer questions about Banksman: features, plans and prices, and how to get started. What would you like to know?</div>
    </div>

    <div class="bmc-chips" data-bmc-chips>
      {SUGGESTIONS.map((s) => <button type="button" class="bmc-chip">{s}</button>)}
    </div>

    <form class="bmc-lead" name="chat-lead" method="POST" data-netlify="true" netlify-honeypot="company_website" data-bmc-lead hidden>
      <input type="hidden" name="form-name" value="chat-lead">
      <input type="hidden" name="transcript" value="">
      <input type="hidden" name="page" value="">
      <SpamGuard />
      <p class="bmc-lead-title">Pass your details to Dom and Matt</p>
      <label>Your name <input name="name" autocomplete="name" required maxlength="120"></label>
      <label>Business name <input name="business" autocomplete="organization" maxlength="160"></label>
      <label>Email <input name="email" type="email" autocomplete="email" required maxlength="254"></label>
      <label>Phone <input name="phone" type="tel" autocomplete="tel" maxlength="40"></label>
      <p class="bmc-small">They'll get these details and this chat, and reply themselves. <a href="/privacy/">Privacy</a></p>
      <div class="bmc-lead-actions">
        <button type="submit" class="btn btn-primary">Send to Dom and Matt</button>
        <button type="button" class="bmc-link" data-bmc-lead-cancel>Not now</button>
      </div>
      <p class="bmc-error" data-bmc-lead-error role="alert" hidden></p>
    </form>

    <form class="bmc-input" data-bmc-form>
      <label class="bmc-sr" for="bmc-text">Your question</label>
      <textarea id="bmc-text" rows="1" maxlength="1500" placeholder="Ask a question…" data-bmc-text required></textarea>
      <button type="submit" class="bmc-send" aria-label="Send">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
      </button>
    </form>
    <p class="bmc-foot">Don't share passwords or bank details. Rather talk to a person? <button type="button" class="bmc-link" data-bmc-person>Pass your details on</button> or ring Dom on <a href={`tel:${SITE.phoneIntl}`}>{SITE.phone}</a>.</p>
  </div>
</div>

<style is:global>
  .bmc[hidden], .bmc [hidden]{display:none !important;}
  .bmc{position:fixed; right:16px; bottom:16px; z-index:90; font-family:'IBM Plex Sans', system-ui, sans-serif;}
  .bmc-open{display:inline-flex; align-items:center; gap:8px; min-height:48px; padding:12px 18px; border:0; border-radius:999px;
    background:var(--accent, #ff7a2e); color:var(--accent-ink, #180d04); font:600 15px/1 'IBM Plex Sans', system-ui, sans-serif;
    box-shadow:0 8px 28px rgba(0,0,0,.45); cursor:pointer;}
  .bmc-open svg{width:20px; height:20px;}
  .bmc-open:focus-visible, .bmc-panel :focus-visible{outline:2px solid var(--sky, #4cc3ff); outline-offset:2px;}
  .bmc.is-open .bmc-open{display:none;}
  .bmc-panel{display:flex; flex-direction:column; width:380px; max-width:calc(100vw - 32px); height:min(600px, calc(100dvh - 32px));
    background:var(--surface, #171c30); color:var(--ink, #f5f3ec); border:1px solid var(--line-strong, rgba(245,243,236,.22));
    border-radius:10px; box-shadow:var(--shadow); overflow:hidden;}
  .bmc-head{display:flex; gap:10px; align-items:flex-start; justify-content:space-between; padding:14px 14px 12px; border-bottom:1px solid var(--line, rgba(245,243,236,.1));}
  .bmc-head h2{margin:0; font-size:16px; font-weight:700;}
  .bmc-head p{margin:3px 0 0; font-size:12.5px; line-height:1.4; color:var(--ink-soft, #c3c9de);}
  .bmc-x{flex:none; width:44px; height:44px; margin:-8px -8px 0 0; display:grid; place-items:center; border:0; background:none; color:var(--ink); cursor:pointer; border-radius:6px;}
  .bmc-x svg{width:20px; height:20px;}
  .bmc-log{flex:1; overflow-y:auto; padding:12px 14px; display:flex; flex-direction:column; gap:10px; overscroll-behavior:contain;}
  .bmc-msg{max-width:88%; padding:9px 12px; border-radius:10px; font-size:14.5px; line-height:1.5; white-space:pre-wrap; overflow-wrap:anywhere;}
  .bmc-bot{align-self:flex-start; background:var(--surface-2, #1f2740);}
  .bmc-me{align-self:flex-end; background:var(--accent-soft, #3d2410);}
  .bmc-msg a{color:var(--sky, #4cc3ff);}
  .bmc-msg.bmc-err{background:rgba(255,90,90,.14); border:1px solid rgba(255,90,90,.4);}
  .bmc-typing::after{content:'…'; animation:bmc-blink 1s infinite;}
  @keyframes bmc-blink{50%{opacity:.3;}}
  .bmc-chips{display:flex; flex-wrap:wrap; gap:6px; padding:0 14px 10px;}
  .bmc-chip{min-height:36px; padding:6px 12px; border-radius:999px; border:1px solid var(--line-strong); background:none; color:var(--ink); font:500 13.5px 'IBM Plex Sans', system-ui, sans-serif; cursor:pointer;}
  .bmc-input{display:flex; gap:8px; align-items:flex-end; padding:10px 14px; border-top:1px solid var(--line);}
  .bmc-input textarea{flex:1; resize:none; max-height:120px; min-height:44px; padding:11px 12px; border-radius:8px; border:1px solid var(--line-strong);
    background:var(--bg, #0d1120); color:var(--ink); font:15px/1.4 'IBM Plex Sans', system-ui, sans-serif;}
  .bmc-send{flex:none; width:44px; height:44px; display:grid; place-items:center; border:0; border-radius:8px; background:var(--accent); color:var(--accent-ink); cursor:pointer;}
  .bmc-send:disabled{opacity:.5; cursor:default;}
  .bmc-send svg{width:20px; height:20px;}
  .bmc-foot{margin:0; padding:0 14px 12px; font-size:12px; line-height:1.45; color:var(--muted, #8890a8);}
  .bmc-foot a, .bmc-small a{color:var(--ink-soft);}
  .bmc-link{border:0; background:none; padding:0; color:var(--sky, #4cc3ff); font:inherit; text-decoration:underline; cursor:pointer;}
  .bmc-lead{margin:0 14px 10px; padding:12px; border:1px solid var(--line-strong); border-radius:8px; display:grid; gap:8px; max-height:60%; overflow-y:auto;}
  .bmc-lead-title{margin:0; font-weight:700; font-size:14.5px;}
  .bmc-lead label{display:grid; gap:3px; font-size:13px; color:var(--ink-soft);}
  .bmc-lead input:not([type=hidden]){min-height:44px; padding:9px 10px; border-radius:6px; border:1px solid var(--line-strong); background:var(--bg); color:var(--ink); font:15px 'IBM Plex Sans', system-ui, sans-serif;}
  .bmc-lead .hp{position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden;}
  .bmc-small{margin:0; font-size:12px; color:var(--muted);}
  .bmc-lead-actions{display:flex; flex-wrap:wrap; gap:12px; align-items:center;}
  .bmc-lead-actions .btn{padding:11px 16px; white-space:normal;}
  .bmc-error{margin:0; color:#ff9a9a; font-size:13px;}
  .bmc-sr{position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0);}
  @media (max-width:480px){
    .bmc{right:12px; bottom:12px;}
    .bmc.is-open{left:8px; right:8px; bottom:8px;}
    .bmc-panel{width:100%; max-width:none; height:calc(100dvh - 16px);}
  }
</style>

<script>
  type Msg = { role: 'user' | 'assistant'; content: string };
  const LEAD_MARKER = '[[lead_form]]';
  const STORE = 'bmc-chat';
  const root = document.querySelector<HTMLElement>('[data-bmc]');

  const store = {
    get(key: string, s: Storage = sessionStorage) { try { return s.getItem(key); } catch { return null; } },
    set(key: string, value: string, s: Storage = sessionStorage) { try { s.setItem(key, value); } catch { /* private window: fine */ } },
  };

  if (root) {
    const fromUrl = new URLSearchParams(location.search).get('chat') === '1';
    if (fromUrl) store.set('bmc-preview', '1');
    if (root.dataset.live === '1' || fromUrl || store.get('bmc-preview') === '1') root.hidden = false;

    const endpoint = root.dataset.endpoint!;
    const panel = root.querySelector<HTMLElement>('.bmc-panel')!;
    const openBtn = root.querySelector<HTMLButtonElement>('[data-bmc-open]')!;
    const log = root.querySelector<HTMLElement>('[data-bmc-log]')!;
    const chips = root.querySelector<HTMLElement>('[data-bmc-chips]')!;
    const form = root.querySelector<HTMLFormElement>('[data-bmc-form]')!;
    const text = root.querySelector<HTMLTextAreaElement>('[data-bmc-text]')!;
    const send = form.querySelector<HTMLButtonElement>('.bmc-send')!;
    const lead = root.querySelector<HTMLFormElement>('[data-bmc-lead]')!;
    const leadError = root.querySelector<HTMLElement>('[data-bmc-lead-error]')!;
    let history: Msg[] = [];
    let busy = false;
    let closed = false;
    try { history = JSON.parse(store.get(STORE) || '[]'); } catch { history = []; }

    // Text with any https links made clickable (never HTML from the reply).
    const fill = (el: HTMLElement, value: string) => {
      el.textContent = '';
      const parts = value.split(/(https:\/\/[^\s<>"')]+[^\s<>"').,;:!?])/g);
      parts.forEach((part, i) => {
        if (i % 2 === 1) {
          const a = document.createElement('a');
          a.href = part; a.textContent = part.replace(/^https:\/\/(www\.)?/, '');
          if (!part.startsWith('https://banksman.app')) { a.target = '_blank'; a.rel = 'noopener'; }
          el.append(a);
        } else if (part) el.append(part);
      });
    };
    const bubble = (role: Msg['role'] | 'error', value: string) => {
      const el = document.createElement('div');
      el.className = 'bmc-msg ' + (role === 'user' ? 'bmc-me' : role === 'error' ? 'bmc-bot bmc-err' : 'bmc-bot');
      fill(el, value);
      log.append(el);
      log.scrollTop = log.scrollHeight;
      return el;
    };
    const clean = (value: string) => value.replace(LEAD_MARKER, '').trim();
    history.forEach((m) => bubble(m.role, clean(m.content)));
    if (history.length) chips.hidden = true;

    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      root.classList.toggle('is-open', open);
      openBtn.setAttribute('aria-expanded', String(open));
      if (open) { text.focus(); log.scrollTop = log.scrollHeight; } else openBtn.focus();
    };
    openBtn.addEventListener('click', () => setOpen(true));
    root.querySelector('[data-bmc-close]')!.addEventListener('click', () => setOpen(false));
    panel.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });

    const showLead = () => { lead.hidden = false; lead.querySelector<HTMLInputElement>('input[name=name]')!.focus(); };
    root.querySelector('[data-bmc-person]')!.addEventListener('click', showLead);
    root.querySelector('[data-bmc-lead-cancel]')!.addEventListener('click', () => { lead.hidden = true; text.focus(); });

    const ask = async (question: string) => {
      if (busy || closed) return;
      busy = true; send.disabled = true; chips.hidden = true;
      history.push({ role: 'user', content: question });
      bubble('user', question);
      const out = bubble('assistant', '');
      out.classList.add('bmc-typing');
      let reply = '';
      try {
        const res = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ messages: history }) });
        const type = res.headers.get('Content-Type') || '';
        if (!type.includes('text/event-stream')) {
          const data = await res.json().catch(() => ({}));
          if (data.reply) { reply = data.reply; closed = !!data.closed; }
          else throw new Error(data.error || `The chat couldn't answer (error ${res.status}).`);
        } else {
          const reader = res.body!.getReader();
          const dec = new TextDecoder();
          let buf = '';
          for (;;) {
            const { value, done } = await reader.read();
            if (done) break;
            buf += dec.decode(value, { stream: true });
            let cut;
            while ((cut = buf.indexOf('\n\n')) >= 0) {
              const line = buf.slice(0, cut).replace(/^data: /, ''); buf = buf.slice(cut + 2);
              const ev = JSON.parse(line);
              if (ev.error) throw new Error(ev.error);
              if (ev.t) { reply += ev.t; fill(out, clean(reply)); out.classList.remove('bmc-typing'); log.scrollTop = log.scrollHeight; }
            }
          }
        }
        if (!reply.trim()) throw new Error("The chat didn't answer. Please try again.");
        out.classList.remove('bmc-typing');
        fill(out, clean(reply));
        history.push({ role: 'assistant', content: reply });
        store.set(STORE, JSON.stringify(history));
        if (reply.includes(LEAD_MARKER)) showLead();
      } catch (err) {
        out.remove();
        history.pop();
        bubble('error', (err as Error).message || 'Something went wrong. Please try again.');
        text.value = question;
      } finally {
        busy = false; send.disabled = false;
        if (closed) { form.hidden = true; }
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = text.value.trim();
      if (!q) return;
      text.value = ''; text.style.height = '';
      ask(q);
    });
    text.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); } });
    text.addEventListener('input', () => { text.style.height = ''; text.style.height = Math.min(text.scrollHeight, 120) + 'px'; });
    chips.querySelectorAll<HTMLButtonElement>('.bmc-chip').forEach((b) => b.addEventListener('click', () => ask(b.textContent || '')));

    lead.addEventListener('submit', async (e) => {
      e.preventDefault();
      leadError.hidden = true;
      (lead.elements.namedItem('transcript') as HTMLInputElement).value = history
        .map((m) => `${m.role === 'user' ? 'Visitor' : 'Assistant'}: ${clean(m.content)}`).join('\n\n').slice(0, 20000);
      (lead.elements.namedItem('page') as HTMLInputElement).value = location.pathname;
      const button = lead.querySelector<HTMLButtonElement>('button[type=submit]')!;
      button.disabled = true;
      try {
        const body = new URLSearchParams(new FormData(lead) as unknown as Record<string, string>).toString();
        const res = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
        if (!res.ok) throw new Error(`Your details weren't sent (error ${res.status}). Please try again, or ring Dom on 07508 300353.`);
        lead.hidden = true;
        bubble('assistant', "Thanks, that's gone to Dom and Matt. One of them will be in touch.");
      } catch (err) {
        leadError.textContent = (err as Error).message;
        leadError.hidden = false;
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
