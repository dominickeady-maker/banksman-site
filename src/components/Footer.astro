---
import { SITE } from '../site';
import { TRADES } from '../data/trades';
import Social from './Social.astro';
---
<footer>
  <div class="wrap">
    <Social />
    <div class="foot-grid">
      <div class="fg-brand">
        <img src="/assets/banksman-logo.png" alt="Banksman.app" width="173" height="28">
        <p>Site management software built by a working builder, for UK construction. Directing every job, every day.</p>
        <a class="fg-badge" href="https://postyourstartup.com/startup/banksman?ref=badge" target="_blank" rel="noopener">
          <img src="https://postyourstartup.com/api/badge/banksman?theme=dark" alt="Featured on PostYourStartup" width="212" height="55" loading="lazy" decoding="async">
        </a>
      </div>
      <div class="fg-product">
        <h3 class="foot-h">Product</h3>
        <a href="/#features">Features</a>
        <a href={SITE.demoUrl}>Live demo</a>
        <a href="/#pricing">Pricing</a>
        <a href="/#white-label">White label</a>
        <a href="/compare/">vs spreadsheets &amp; WhatsApp</a>
        <a href="/tools/">Free tools</a>
        <a href="/tools/day-rate-calculator/">Day rate calculator</a>
        <a href="/tools/cis-calculator/">CIS calculator</a>
        <a href={SITE.appUrl}>Log in</a>
      </div>
      <div class="fg-trades">
        <h3 class="foot-h">Who it's for</h3>
        <div class="fg-trade-links">{TRADES.map((trade) => <a href={`/for-${trade.slug}/`}>{trade.name}</a>)}</div>
      </div>
      <div class="fg-company">
        <h3 class="foot-h">Company</h3>
        <a href="/meet-the-team/">Meet the team</a>
        <a href="/case-studies/">Case studies</a>
        <a href="/whats-new/">What's new</a>
        <a href="/whats-new/video/">What's new in Banksman</a>
        <a href="/blog/">Blog</a>
        <a href="/support/">Support</a>
        <a href="/privacy/">Privacy &amp; cookies</a>
        <button class="linklike" type="button" onclick="openCookieSettings()">Cookie settings</button>
      </div>
      <div class="fg-contact">
        <h3 class="foot-h">Contact</h3>
        {SITE.contacts.map((c) => (
          <div class="fg-person">
            <span class="fg-name">{c.name}</span>
            <a href={`mailto:${c.email}`}>{c.email}</a>
          </div>
        ))}
        <a class="btn btn-primary btn-sm fg-call" href={SITE.contactUrl}>Request a call</a>
      </div>
    </div>
    <div class="legal-line">Banksman is a product of {SITE.company}. © {new Date().getFullYear()}.</div>
  </div>
</footer>
