---
import { SITE } from '../site';
import { TRADES } from '../data/trades';
import Social from './Social.astro';
---
<footer>
  <div class="wrap">
    <Social />
    <div class="foot-grid">
      <div class="fg-brand">
        <img src="/assets/banksman-logo.png" alt="Banksman.app" width="173" height="28">
        <p>Site management software built by a working builder, for UK construction. Directing every job, every day.</p>
      </div>
      <div>
        <h3 class="foot-h">Product</h3>
        <a href="/#features">Features</a>
        <a href={SITE.demoUrl}>Live demo</a>
        <a href="/#pricing">Pricing</a>
        <a href="/#white-label">White label</a>
        <a href="/compare/">vs spreadsheets &amp; WhatsApp</a>
        <a href="/tools/">Free tools</a>
        <a href={SITE.appUrl}>Log in</a>
      </div>
      <div>
        <h3 class="foot-h">Who it's for</h3>
        {TRADES.map((trade) => <a href={`/for-${trade.slug}/`}>{trade.name}</a>)}
      </div>
      <div>
        <h3 class="foot-h">Company</h3>
        <a href="/meet-the-team/">Meet the team</a>
        <a href="/whats-new/">What's new</a>
        <a href="/blog/">Blog</a>
        <a href="/support/">Support</a>
        <a href="/privacy/">Privacy &amp; cookies</a>
        <button class="linklike" type="button" onclick="openCookieSettings()">Cookie settings</button>
        {SITE.contacts.map((c) => (
          <>
            <a href={`tel:${c.phoneIntl}`}>{c.name}: {c.phone}</a>
            <a href={`mailto:${c.email}`}>{c.email}</a>
          </>
        ))}
      </div>
    </div>
    <div class="legal-line">Banksman is a product of {SITE.company}. © {new Date().getFullYear()}.</div>
  </div>
</footer>
