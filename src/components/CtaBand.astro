---
import { SITE } from '../site';

// The closing call to action on landing, tool and compare pages. It sends people to the demo form
// on the home page (SITE.demoUrl) rather than repeating the form.
interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = 'Have a proper look.',
  text = 'The live demo is the actual app on realistic sample data. Four fields and your logins are on the next page. No card.',
} = Astro.props;
---
<section class="final cta-band">
  <div class="wrap">
    <h2>{heading}</h2>
    <p class="cta-text">{text}</p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href={SITE.demoUrl}>Try the live demo →</a>
      <a class="btn btn-ghost" href={`tel:${SITE.phoneIntl}`}>Give us a ring</a>
    </div>
    <p class="small-print">{SITE.realPeople}<br>{SITE.contacts.map((c, i) => <>{i > 0 && ' · '}{c.name}: <a href={`tel:${c.phoneIntl}`}>{c.phone}</a></>)}</p>
  </div>
</section>
